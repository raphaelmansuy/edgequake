---
import EcosystemSection from "../components/sections/Ecosystem.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHero from "../components/primitives/PageHero.astro";
import Section from "../components/primitives/Section.astro";
import { getProductVersion } from "../lib/product";

const version = getProductVersion();
---

<MarketingLayout
  title="Ecosystem — UI, API, MCP, and crates"
  description="EdgeQuake product surfaces: Web UI, REST/OpenAPI, MCP for agents, GHCR images, and the modular Rust workspace."
>
  <PageHero
    title="The EdgeQuake ecosystem"
    lede={`Ship the product as Docker images, talk to it over REST or MCP, or embed the Rust crates. Current line: v${version}.`}
    align="center"
    container="max-w-3xl"
  />

  <EcosystemSection />

  <Section container="max-w-3xl">
    <h2 class="text-xl font-semibold mkt-text">Fastest install</h2>
    <p class="mt-2 text-sm mkt-text-muted">
      Prefer Docker over crates.io for the full stack (UI + API + Postgres):
    </p>
    <pre
      class="mt-3 mkt-code-surface rounded-lg p-4 text-sm overflow-x-auto mkt-accent-text"
    ><code>curl -fsSL https://raw.githubusercontent.com/raphaelmansuy/edgequake/edgequake-main/quickstart.sh | sh</code></pre>

    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href="/demo/" class="mkt-inline-link">Try the demo</a>
      <a href="/docs/getting-started/" class="mkt-inline-link">Getting started</a>
      <a href="/docs/integrations/" class="mkt-inline-link">MCP and integrations</a>
      <a href="/enterprise/" class="mkt-inline-link">Enterprise</a>
    </div>
  </Section>
</MarketingLayout>
