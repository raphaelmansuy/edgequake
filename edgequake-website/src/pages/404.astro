---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Button from "../components/primitives/Button.astro";
import Icon from "../components/primitives/Icon.astro";
import PageHero from "../components/primitives/PageHero.astro";
---

<MarketingLayout
  title="Page Not Found"
  description="The page you requested could not be found. Return to the EdgeQuake homepage or continue into the documentation."
  noIndex={true}
>
  <PageHero
    title="404"
    lede="The page you’re looking for doesn’t exist or has moved."
    align="center"
    glow
    container="max-w-2xl"
  >
    <div
      slot="leading"
      class="mkt-accent-surface mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl"
      aria-hidden="true"
    >
      <Icon name="zap" class="h-8 w-8" />
    </div>

    <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed mkt-text-muted">
      Continue with the{" "}
      <a href="/docs/" class="mkt-inline-link">documentation</a>, explore the{" "}
      <a href="/demo/" class="mkt-inline-link">demo workflow</a>, browse the{" "}
      <a href="/ecosystem/" class="mkt-inline-link">crate ecosystem</a>, or review{" "}
      <a href="/enterprise/" class="mkt-inline-link">enterprise deployment paths</a>.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href="/" variant="primary" size="lg">Back to Home</Button>
      <Button href="/docs/" variant="outline" size="lg">Documentation</Button>
      <Button href="/demo/" variant="outline" size="lg">Demo Workflow</Button>
    </div>
  </PageHero>
</MarketingLayout>
