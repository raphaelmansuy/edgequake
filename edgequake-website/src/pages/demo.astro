---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout title="Live Demo">
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
          Try EdgeQuake Live
        </h1>
        <p class="mt-6 text-lg text-gray-400">
          Upload a document, build a knowledge graph, and query it — all in your browser.
        </p>
      </div>

      <div class="mt-12 rounded-xl border border-gray-800 bg-gray-900 p-8 text-center">
        <div class="mx-auto max-w-md">
          <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-500/10 text-accent-400 mb-6">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-white">Interactive Demo</h2>
          <p class="mt-3 text-gray-400">
            The live demo connects to a running EdgeQuake instance. Start the
            local stack with <code class="text-accent-400 bg-gray-800 px-1.5 py-0.5 rounded text-sm">make dev</code> to try it yourself.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href="/docs/getting-started/"
              class="inline-flex items-center rounded-lg bg-accent-600 px-6 py-3 text-sm font-semibold text-white hover:bg-accent-500 transition-colors"
            >
              Getting Started Guide
            </a>
            <a
              href="https://github.com/raphaelmansuy/edgequake"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-gray-700 px-6 py-3 text-sm font-semibold text-gray-300 hover:text-white hover:border-gray-500 transition-colors"
            >
              View Source
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
