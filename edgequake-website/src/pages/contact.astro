---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Icon from "../components/primitives/Icon.astro";
import Section from "../components/primitives/Section.astro";
import type { IconName } from "../components/data/icons";

const channels: {
  icon: IconName;
  title: string;
  href: string;
  label: string;
  external?: boolean;
}[] = [
  {
    icon: "mail",
    title: "Email",
    href: "mailto:contact@elitizon.com",
    label: "contact@elitizon.com",
  },
  {
    icon: "users",
    title: "LinkedIn",
    href: "https://www.linkedin.com/in/raphaelmansuy/",
    label: "Message Raphael Mansuy",
    external: true,
  },
  {
    icon: "share-2",
    title: "GitHub",
    href: "https://github.com/raphaelmansuy/edgequake/discussions",
    label: "Open a Discussion",
    external: true,
  },
  {
    icon: "globe",
    title: "Elitizon",
    href: "https://elitizon.com",
    label: "elitizon.com",
    external: true,
  },
];

const routes = [
  {
    href: "https://www.linkedin.com/in/raphaelmansuy/",
    title: "Message Raphael on LinkedIn",
    body: "Best for demo access, collaboration, and building on EdgeQuake with its creator.",
    badge: "direct",
    external: true,
  },
  {
    href: "mailto:contact@elitizon.com?subject=EdgeQuake%20Inquiry",
    title: "Email the team",
    body: "Best for product questions, architecture reviews, and implementation support.",
    badge: "mailto",
  },
  {
    href: "https://github.com/raphaelmansuy/edgequake/discussions",
    title: "Open a GitHub discussion",
    body: "Best for community questions, feature ideas, and public technical conversations.",
    badge: "community",
    external: true,
  },
  {
    href: "https://elitizon.com",
    title: "Talk to Elitizon",
    body: "Best for enterprise engagements, custom delivery, and partnership discussions.",
    badge: "enterprise",
    external: true,
  },
];

const starters = [
  {
    href: "/docs/getting-started/",
    title: "Getting started docs",
    body: "Install EdgeQuake, run the stack, and learn the core concepts.",
  },
  {
    href: "/docs/operations/",
    title: "Operations guide",
    body: "Review deployment, configuration, and monitoring guidance.",
  },
  {
    href: "/ecosystem/",
    title: "Ecosystem overview",
    body: "See which crate or service boundary best matches your use case.",
  },
  {
    href: "/demo/",
    title: "Demo workflow",
    body: "Walk through ingestion, graph construction, and query validation.",
  },
];
---

<MarketingLayout
  title="Contact the Team | EdgeQuake"
  description="Reach the EdgeQuake team for architecture reviews, enterprise deployment support, implementation questions, or partnership discussions."
>
  <Section container="max-w-7xl" class="!pt-[clamp(5rem,10vh,7.5rem)]">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h1 class="mkt-display">Contact the EdgeQuake Team</h1>
        <p class="mkt-lede">
          Reach out if you are evaluating Graph-RAG for production, planning a
          self-hosted deployment, or deciding how EdgeQuake fits into your
          current retrieval stack.
        </p>

        <p class="mt-4 text-sm leading-relaxed mkt-text-dim">
          If you are still comparing options, start with the{" "}
          <a href="/docs/" class="mkt-inline-link">documentation</a>, the{" "}
          <a href="/demo/" class="mkt-inline-link">demo workflow</a>, or the{" "}
          <a href="/enterprise/" class="mkt-inline-link">enterprise overview</a>
          {" "}before opening a deeper conversation.
        </p>

        <div class="mt-12 space-y-6">
          {
            channels.map((c) => (
              <div class="flex items-start gap-4">
                <div class="mkt-accent-surface flex h-11 w-11 shrink-0 items-center justify-center rounded-lg">
                  <Icon name={c.icon} class="h-5 w-5" />
                </div>
                <div>
                  <h3 class="font-semibold mkt-text">{c.title}</h3>
                  <p class="mkt-text-muted">
                    <a
                      href={c.href}
                      class="mkt-inline-link"
                      target={c.external ? "_blank" : undefined}
                      rel={c.external ? "noopener noreferrer" : undefined}
                    >
                      {c.label}
                    </a>
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mkt-card mkt-card-static rounded-xl p-8">
        <h2 class="text-xl font-semibold mkt-text">Choose Your Contact Route</h2>
        <p class="mt-3 mkt-text-muted">
          Use a verified channel so your message reaches the right team quickly.
        </p>

        <ul class="mt-6 list-none space-y-0 p-0 m-0">
          {
            routes.map((r) => (
              <li class="border-t mkt-border-subtle py-5 first:border-t-0 first:pt-0">
                <a
                  href={r.href}
                  target={r.external ? "_blank" : undefined}
                  rel={r.external ? "noopener noreferrer" : undefined}
                  class="group block min-h-11 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-base font-semibold mkt-text transition-colors group-hover:mkt-accent-text">
                        {r.title}
                      </h3>
                      <p class="mt-1 text-sm mkt-text-muted">{r.body}</p>
                    </div>
                    <span class="shrink-0 text-sm font-semibold mkt-accent-text">
                      {r.badge}
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mkt-code-surface mt-6 rounded-xl p-4 text-sm mkt-text-secondary">
          Typical response window: 1 to 2 business days.
        </div>

        <div class="mt-8 border-t mkt-border-subtle pt-6">
          <h3 class="text-base font-semibold mkt-text">Helpful starting points</h3>
          <ul class="mt-4 grid list-none gap-0 p-0 m-0 sm:grid-cols-2 sm:gap-x-8">
            {
              starters.map((s) => (
                <li class="border-t mkt-border-subtle py-4">
                  <a
                    href={s.href}
                    class="block min-h-11 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4"
                  >
                    <div class="text-sm font-semibold mkt-text transition-colors hover:mkt-accent-text">
                      {s.title}
                    </div>
                    <p class="mt-1 text-sm mkt-text-muted">{s.body}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>
</MarketingLayout>
