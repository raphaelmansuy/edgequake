---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getProductVersion } from "../lib/product";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Graph-RAG in Rust: one binary, one Postgres, any LLM. Turn documents into a knowledge graph and get answers with sources.",
  ogImage = "/og-default.png",
  ogImageAlt = "EdgeQuake – Graph-RAG Built to Ship. Upload documents, explore the knowledge graph, ask grounded questions.",
  noIndex = false,
} = Astro.props;

const productVersion = getProductVersion();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pageTitle = `${title} | EdgeQuake`;
const pageTitleIsBrandOnly = title.trim().toLowerCase() === "edgequake";
const resolvedTitle = pageTitleIsBrandOnly ? "EdgeQuake" : pageTitle;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://edgequake.com/#organization",
      name: "Elitizon",
      url: "https://elitizon.com",
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", Astro.site).toString(),
        width: 32,
        height: 32,
      },
      sameAs: [
        "https://github.com/raphaelmansuy/edgequake",
        "https://elitizon.com",
        "https://twitter.com/raphaelmansuy",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://edgequake.com/#website",
      name: "EdgeQuake",
      url: Astro.site?.toString(),
      publisher: {
        "@id": "https://edgequake.com/#organization",
      },
      inLanguage: "en",
    },
    {
      "@type": "SiteNavigationElement",
      "@id": "https://edgequake.com/#nav",
      name: "Primary",
      hasPart: [
        { "@type": "WebPage", name: "Docs", url: "https://edgequake.com/docs/" },
        {
          "@type": "WebPage",
          name: "Tutorial",
          url: "https://edgequake.com/tutorial/",
        },
        { "@type": "WebPage", name: "Demo", url: "https://edgequake.com/demo/" },
        {
          "@type": "WebPage",
          name: "Ecosystem",
          url: "https://edgequake.com/ecosystem/",
        },
        {
          "@type": "WebPage",
          name: "Enterprise",
          url: "https://edgequake.com/enterprise/",
        },
        {
          "@type": "WebPage",
          name: "Collaborate",
          url: "https://edgequake.com/work-with-raphael/",
        },
        {
          "@type": "WebPage",
          name: "Contact",
          url: "https://edgequake.com/contact/",
        },
      ],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonicalUrl.toString()}#software`,
      name: "EdgeQuake",
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Knowledge Graph / RAG Framework",
      operatingSystem: "Linux, macOS, Windows",
      description,
      url: canonicalUrl.toString(),
      image: {
        "@type": "ImageObject",
        url: ogImageUrl.toString(),
        width: 1200,
        height: 630,
      },
      screenshot: {
        "@type": "ImageObject",
        url: ogImageUrl.toString(),
        width: 1200,
        height: 630,
        caption: "EdgeQuake Graph-RAG framework social preview",
      },
      softwareVersion: productVersion,
      programmingLanguage: ["Rust", "TypeScript"],
      keywords: "graph-rag, knowledge-graph, rust, llm, postgresql, rag, ai, nlp",
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      license:
        "https://github.com/raphaelmansuy/edgequake/blob/edgequake-main/LICENSE",
      codeRepository: "https://github.com/raphaelmansuy/edgequake",
      downloadUrl: "https://github.com/raphaelmansuy/edgequake/releases",
      publisher: {
        "@id": "https://edgequake.com/#organization",
      },
      author: {
        "@type": "Person",
        name: "Raphael Mansuy",
        url: "https://github.com/raphaelmansuy",
        sameAs: "https://twitter.com/raphaelmansuy",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl.toString()}#webpage`,
      url: canonicalUrl.toString(),
      name: resolvedTitle,
      description,
      isPartOf: {
        "@id": "https://edgequake.com/#website",
      },
      about: {
        "@id": `${canonicalUrl.toString()}#software`,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageUrl.toString(),
      },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content="EdgeQuake" />
    <meta name="apple-mobile-web-app-title" content="EdgeQuake" />
    <meta name="author" content="Elitizon" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- llmstxt.org v2: agents discover the covering brief via describedby -->
    <link rel="describedby" href="/llms.txt" title="LLM site map" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="llms.txt"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="llms-full.txt"
    />

    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large"}
    />
    <meta id="theme-color-meta" name="theme-color" content="#09090b" />
    <meta
      name="theme-color"
      content="#09090b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta name="color-scheme" content="dark light" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Slack, Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="EdgeQuake" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter / X Card (summary_large_image = 1200×630 banner) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@raphaelmansuy" />
    <meta name="twitter:creator" content="@raphaelmansuy" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />

    <!-- Fonts: Space Grotesk (display) + IBM Plex Sans (body) + JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=optional"
      rel="stylesheet"
    />

    <!-- Theme detection (runs before paint to prevent flash) -->
    <script is:inline>
      (function () {
        var theme = localStorage.getItem("starlight-theme");
        var themeColorMeta = document.getElementById("theme-color-meta");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
          if (themeColorMeta) {
            themeColorMeta.setAttribute(
              "content",
              theme === "light" ? "#ffffff" : "#09090b",
            );
          }
        } else {
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var resolvedTheme = prefersDark ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", resolvedTheme);
          if (themeColorMeta) {
            themeColorMeta.setAttribute(
              "content",
              resolvedTheme === "light" ? "#ffffff" : "#09090b",
            );
          }
        }
      })();
    </script>

    <!-- SPEC-170: mark JS-on before paint so .reveal can start hidden without a
         flash. When JS is off (or this never runs), .reveal stays visible. -->
    <script is:inline>
      document.documentElement.classList.add("reveal-ready");
    </script>
  </head>
  <body
    class="mkt-site min-h-screen mkt-bg mkt-text font-sans antialiased overflow-x-hidden"
  >
    <a class="mkt-skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />

    <!-- SPEC-170: reveal-on-scroll (opacity/transform only → never shifts layout).
         Reduced-motion is handled in CSS; here we just toggle visibility. -->
    <script>
      const els = document.querySelectorAll("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
