---
/**
 * Solution — product capabilities as a readable grid (SPEC-170 + ui-ux-pro-max).
 * Titles are the only links; body copy stays muted with no underline noise.
 */
import Icon from "../primitives/Icon.astro";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";
import type { IconName } from "../data/icons";

const features: {
  icon: IconName;
  title: string;
  description: string;
  href: string;
}[] = [
  {
    icon: "brain",
    title: "A knowledge graph on Postgres",
    description:
      "Entities and relationships live in ordinary PostgreSQL tables with pgvector. Apache AGE is optional — product images run without it.",
    href: "/docs/architecture/",
  },
  {
    icon: "users",
    title: "Members, invites, and magic links",
    description:
      "Invite teammates, set roles, suspend accounts, and issue one-time sign-in or reset links — without wiring SMTP first.",
    href: "/tutorial/14-members-and-invites/",
  },
  {
    icon: "shield",
    title: "SSO and workspace isolation",
    description:
      "OIDC and Keycloak sign-in plus Postgres row-level security keep tenants and workspaces separated across the UI, API, and MCP.",
    href: "/docs/security/",
  },
  {
    icon: "bot",
    title: "MCP for AI agents",
    description:
      "Assistants can search, ingest, upload, delete, poll jobs, download documents, and fetch graph images through MCP.",
    href: "/docs/integrations/",
  },
  {
    icon: "file-text",
    title: "PDF vision and manuscripts",
    description:
      "Turn hard PDFs into usable markdown — tables, layouts, and scanned or handwritten pages through a dedicated manuscript path.",
    href: "/docs/tutorials/pdf-ingestion/",
  },
  {
    icon: "plug",
    title: "Any LLM, encrypted connections",
    description:
      "OpenAI, Anthropic, Mistral, Gemini, or Ollama and LM Studio. Save connections with encrypted keys; the wizard finds local servers.",
    href: "/docs/providers/",
  },
];
---

<Section>
  <SectionHeader
    title="Built for real Graph-RAG work"
    lede="Ingest once, keep structure and lineage, then answer with the retrieval mode that fits the question — on a stack you can run and upgrade."
  />

  <ul class="mt-12 grid list-none gap-x-10 gap-y-0 p-0 m-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <li class="min-w-0 border-t mkt-border-subtle py-7">
          <span class="mkt-accent-surface inline-flex h-11 w-11 items-center justify-center rounded-lg">
            <Icon name={f.icon} class="h-5 w-5" />
          </span>
          <h3 class="mt-4 text-base font-semibold leading-snug">
            <a
              href={f.href}
              class="inline-flex min-h-11 items-center mkt-text transition-colors duration-200 hover:mkt-accent-text focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {f.title}
            </a>
          </h3>
          <p class="mt-1 text-sm leading-relaxed mkt-text-muted">{f.description}</p>
          <p class="mt-2">
            <a
              href={f.href}
              class="mkt-inline-link inline-flex min-h-11 items-center text-sm cursor-pointer"
            >
              Read in docs
            </a>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-sm mkt-text-muted leading-relaxed max-w-3xl">
    Plus explicit{" "}
    <code class="mkt-text-secondary">edgequake migrate</code> upgrades, hybrid
    cloud LLM with local embeddings, and side-by-side PDF citations.{" "}
    <a
      href="/docs/whats-new/"
      class="mkt-inline-link inline-flex min-h-11 items-center"
      >See what’s new</a
    >.
  </p>
</Section>
