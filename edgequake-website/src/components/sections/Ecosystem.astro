---
/**
 * Ecosystem section — Crate overview grid.
 * Content ported from _archive/ecosystem.tsx
 */
const crates = [
  {
    name: "edgequake-core",
    version: "0.7.0",
    description: "Orchestration layer — pipeline management, workspace isolation, and the top-level EdgeQuake API.",
  },
  {
    name: "edgequake-api",
    version: "0.7.0",
    description: "REST API service built with Axum. Health checks, document upload, query endpoints, and SSE streaming.",
  },
  {
    name: "edgequake-storage",
    version: "0.7.0",
    description: "Storage adapters for PostgreSQL + Apache AGE. KV, vector, and graph storage behind a unified trait.",
  },
  {
    name: "edgequake-pipeline",
    version: "0.7.0",
    description: "Document processing pipeline. Chunking, entity extraction, relationship mapping, and deduplication.",
  },
  {
    name: "edgequake-query",
    version: "0.7.0",
    description: "Query engine supporting 6 retrieval modes: local, global, hybrid, naive, mix, and graph-aware.",
  },
  {
    name: "edgequake-llm",
    version: "0.3.0",
    description: "LLM provider abstraction. OpenAI, Ollama, LM Studio, and mock providers with automatic selection.",
  },
  {
    name: "edgequake-pdf",
    version: "0.7.0",
    description: "PDF-to-markdown conversion with embedded pdfium. Vision LLM support for tables and complex layouts.",
  },
  {
    name: "edgequake-graph",
    version: "0.7.0",
    description: "Graph algorithms and traversal. Community detection, entity resolution, and knowledge graph operations.",
  },
];
---

<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Modular by Design
      </h2>
      <p class="mt-4 text-lg text-gray-400">
        {crates.length} focused crates. Use the full stack or pick just what you need.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {crates.map((c) => (
        <div class="rounded-xl border border-gray-800 bg-gray-900/80 p-5 hover:border-accent-500/30 transition-colors">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold font-mono text-accent-400">{c.name}</h3>
            <span class="text-xs text-gray-500">v{c.version}</span>
          </div>
          <p class="mt-3 text-xs text-gray-400 leading-relaxed">{c.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
