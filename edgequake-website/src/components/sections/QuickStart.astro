---
import { Code } from "@astrojs/starlight/components";
import { getProductVersion } from "../../lib/product";
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const version = getProductVersion();

const tabs = [
  {
    id: "docker",
    label: "Docker",
    title: "quickstart.sh",
    lang: "bash",
    summary:
      "One script pulls the stack. No git clone, Rust, or Node.js required.",
    code: `# Needs Docker only
curl -fsSL https://raw.githubusercontent.com/raphaelmansuy/edgequake/edgequake-main/quickstart.sh | sh

# Pin this release:
# EDGEQUAKE_VERSION=${version} sh quickstart.sh

# Then open http://localhost:3000
# API / Swagger → http://localhost:8080 · /swagger-ui

# Headless / CI examples:
# quickstart.sh --yes --provider ollama
# EDGEQUAKE_LLM_PROVIDER=openai OPENAI_API_KEY=sk-... quickstart.sh --yes`,
  },
  {
    id: "api",
    label: "REST API",
    title: "api-demo.sh",
    lang: "bash",
    summary: "Upload a PDF, then ask a hybrid query.",
    code: `# Upload a document
curl -X POST http://localhost:8080/api/v1/documents/upload \\
  -F "file=@your-document.pdf"

# Query the knowledge graph
curl -X POST http://localhost:8080/api/v1/query \\
  -H "Content-Type: application/json" \\
  -d '{"query": "What are the main concepts?", "mode": "hybrid"}'`,
  },
  {
    id: "ui",
    label: "Web UI",
    title: "First five minutes",
    lang: "bash",
    summary:
      "After quickstart, walk the UI — or follow the picture tour with screenshots.",
    code: `# 1. Open http://localhost:3000
# 2. Finish the connection wizard (Ollama / cloud key)
# 3. Drop a PDF on Documents
# 4. Ask a question on Query (try hybrid)
# 5. Open Knowledge Graph to see entities

# Picture tour with screenshots:
# https://edgequake.com/tutorial/`,
  },
];
---

<Section id="quickstart" tone="alt" focal container="max-w-7xl">
  <SectionHeader
    align="center"
    title="Up and running in minutes"
    lede="One Docker command starts the full stack. Or call the REST API, or follow the web UI after the wizard detects your local models."
  />

    <div class="mt-12 mx-auto max-w-3xl overflow-hidden rounded-2xl border mkt-border mkt-elevate bg-[var(--mkt-bg-card-solid)]">
      <div
        class="mkt-tablist flex px-2 pt-2 sm:px-4 sm:pt-3"
        role="tablist"
        aria-label="Quick start examples"
      >
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              data-tab={tab.id}
              class={`mkt-tab min-h-11 cursor-pointer px-4 py-2.5 text-sm font-medium transition-colors duration-200 ${i === 0 ? "is-active" : ""}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              tabindex={i === 0 ? "0" : "-1"}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {
        tabs.map((tab, i) => (
          <div
            data-panel={tab.id}
            id={`panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${tab.id}`}
            tabindex="0"
            class={`relative ${i === 0 ? "" : "hidden"}`}
          >
            <div class="mkt-code-showcase rounded-b-2xl border border-t-0 p-4 sm:p-6 overflow-x-auto">
              <p class="mb-4 text-sm mkt-text-secondary">{tab.summary}</p>
              <Code code={tab.code} lang={tab.lang} title={tab.title} />
            </div>
          </div>
        ))
      }
    </div>
</Section>

<script>
  const setupQuickStartTabs = () => {
    document.querySelectorAll('[role="tablist"]').forEach((tablist) => {
      if (tablist instanceof HTMLElement && tablist.dataset.bound === "true") {
        return;
      }

      const tabs = Array.from(
        tablist.querySelectorAll<HTMLElement>('[role="tab"]'),
      );
      const section = tablist.closest("section");
      const panels = Array.from(
        section?.querySelectorAll<HTMLElement>("[data-panel]") ?? [],
      );

      const activateTab = (nextTab?: HTMLElement) => {
        const nextId = nextTab?.dataset.tab;
        tabs.forEach((tab) => {
          const isActive = tab === nextTab;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
          tab.setAttribute("tabindex", isActive ? "0" : "-1");
        });

        panels.forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.panel !== nextId);
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(tab));
        tab.addEventListener("keydown", (event: KeyboardEvent) => {
          let nextIndex = index;

          if (event.key === "ArrowRight") {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          const nextTab = tabs[nextIndex];
          activateTab(nextTab);
          nextTab?.focus();
        });
      });

      if (tablist instanceof HTMLElement) {
        tablist.dataset.bound = "true";
      }
    });
  };

  setupQuickStartTabs();
</script>
