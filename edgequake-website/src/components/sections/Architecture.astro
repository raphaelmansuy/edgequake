---
/**
 * Architecture — pastel pipeline diagram (SPEC-170 / Astra).
 * Colors match scripts/mermaid-theme.json so marketing and docs diagrams feel related.
 */
import Section from "../primitives/Section.astro";
import SectionHeader from "../primitives/SectionHeader.astro";

const stages = [
  "Documents",
  "Ingestion Pipeline",
  "PostgreSQL Storage",
  "Query Engine",
  "REST API",
];
---

<Section tone="base" container="max-w-7xl">
  <SectionHeader
    title="From files to answers with sources"
    lede="Ingest once. Keep structure and lineage in PostgreSQL with pgvector and graph tables. Serve six retrieval modes from the same store."
  />

  <div class="mt-12 flex justify-center">
    <div class="mkt-card mkt-card-static w-full max-w-4xl p-4 sm:p-8">
      <!-- Mobile: vertical pastel steps -->
      <div class="sm:hidden">
        <ol class="flex flex-col items-center gap-1">
          {
            stages.map((stage, i) => (
              <li class="flex w-full flex-col items-center">
                <div class="w-full rounded-lg border border-indigo-300 bg-indigo-50 px-4 py-3 text-center dark:border-indigo-400/40 dark:bg-indigo-500/15">
                  <span class="text-sm font-semibold text-indigo-950 dark:text-indigo-100">
                    {stage}
                  </span>
                </div>
                {i < stages.length - 1 && (
                  <svg width="16" height="20" viewBox="0 0 16 20" aria-hidden="true">
                    <line x1="8" y1="0" x2="8" y2="14" stroke="#818CF8" stroke-width="1.5" />
                    <polygon points="2,12 8,20 14,12" fill="#818CF8" />
                  </svg>
                )}
              </li>
            ))
          }
        </ol>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <span class="rounded-md border border-amber-300/80 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-950 dark:border-amber-400/40 dark:bg-amber-500/15 dark:text-amber-100">
            LLM Provider
          </span>
          <span class="rounded-md border border-pink-300/80 bg-pink-50 px-3 py-1.5 text-xs font-medium text-pink-950 dark:border-pink-400/40 dark:bg-pink-500/15 dark:text-pink-100">
            Clients
          </span>
        </div>
      </div>

      <!-- Desktop: pastel SVG -->
      <div class="hidden sm:block overflow-x-auto">
        <svg
          viewBox="0 0 800 340"
          class="w-full min-w-[640px]"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Pipeline from documents through ingestion, PostgreSQL, query engine, and REST API, with LLM provider and clients"
        >
          <defs>
            <marker
              id="eq-arrow"
              markerWidth="10"
              markerHeight="7"
              refX="10"
              refY="3.5"
              orient="auto"
            >
              <polygon points="0 0, 10 3.5, 0 7" fill="#818CF8"></polygon>
            </marker>
          </defs>

          <g
            font-family="IBM Plex Sans, ui-sans-serif, system-ui, sans-serif"
            font-size="13"
            text-anchor="middle"
          >
            <!-- Documents — primary pastel -->
            <rect x="20" y="130" width="110" height="60" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="1.5"></rect>
            <text x="75" y="165" fill="#1E1B4B" font-weight="600">Documents</text>

            <!-- Ingestion -->
            <rect x="170" y="130" width="140" height="60" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="1.5"></rect>
            <text x="240" y="158" fill="#1E1B4B" font-weight="600">Ingestion</text>
            <text x="240" y="175" fill="#1E1B4B" font-weight="600">Pipeline</text>

            <!-- PostgreSQL — store pastel -->
            <rect x="350" y="130" width="140" height="60" rx="10" fill="#D1FAE5" stroke="#10B981" stroke-width="1.5"></rect>
            <text x="420" y="158" fill="#064E3B" font-weight="600">PostgreSQL</text>
            <text x="420" y="175" fill="#064E3B" font-weight="600">Storage</text>

            <!-- Query Engine -->
            <rect x="530" y="130" width="120" height="60" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="1.5"></rect>
            <text x="590" y="165" fill="#1E1B4B" font-weight="600">Query Engine</text>

            <!-- REST API -->
            <rect x="690" y="130" width="90" height="60" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="1.5"></rect>
            <text x="735" y="165" fill="#1E1B4B" font-weight="600">REST API</text>

            <!-- LLM Provider — llm pastel -->
            <rect x="300" y="260" width="140" height="50" rx="10" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5"></rect>
            <text x="370" y="290" fill="#451A03" font-weight="600">LLM Provider</text>

            <!-- Clients — actor pastel -->
            <rect x="660" y="260" width="120" height="50" rx="10" fill="#FCE7F3" stroke="#EC4899" stroke-width="1.5"></rect>
            <text x="720" y="290" fill="#500724" font-weight="600">Clients</text>
          </g>

          <g stroke="#818CF8" stroke-width="1.5" fill="none" marker-end="url(#eq-arrow)">
            <line x1="130" y1="160" x2="170" y2="160"></line>
            <line x1="310" y1="160" x2="350" y2="160"></line>
            <line x1="490" y1="160" x2="530" y2="160"></line>
            <line x1="650" y1="160" x2="690" y2="160"></line>
          </g>
          <g stroke="#94A3B8" stroke-width="1.5" fill="none" stroke-dasharray="5 4">
            <line x1="370" y1="260" x2="240" y2="190"></line>
            <line x1="370" y1="260" x2="590" y2="190"></line>
            <line x1="735" y1="260" x2="735" y2="190"></line>
          </g>
        </svg>
      </div>

      <p class="mt-6 text-sm leading-relaxed mkt-text-muted">
        Ingest once, keep structure and lineage in Postgres, then serve multiple
        retrieval modes from a storage layer built for production rather than a
        prototype glue stack.
      </p>
    </div>
  </div>
</Section>
