---
const navLinks = [
  { label: "Docs", href: "/docs/" },
  { label: "Demo", href: "/demo/" },
  { label: "Ecosystem", href: "/ecosystem/" },
  { label: "Enterprise", href: "/enterprise/" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-gray-800/50 bg-gray-950/80 backdrop-blur-lg"
  data-pagefind-ignore
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white hover:opacity-90 transition-opacity">
      <svg class="h-7 w-7 text-accent-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
      </svg>
      <span class="text-lg font-bold tracking-tight">EdgeQuake</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-2 text-sm font-medium text-gray-300 hover:text-white transition-colors rounded-md hover:bg-white/5"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <!-- GitHub -->
      <a
        href="https://github.com/raphaelmansuy/edgequake"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:flex items-center justify-center rounded-md p-2 text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
        aria-label="GitHub"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
        </svg>
      </a>

      <!-- Get Started CTA -->
      <a
        href="/docs/getting-started/"
        class="hidden sm:inline-flex items-center rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white hover:bg-accent-500 transition-colors"
      >
        Get Started
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:text-white hover:bg-white/5"
        aria-label="Toggle menu"
        id="mobile-menu-btn"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-800/50 bg-gray-950/95 backdrop-blur-lg"
    aria-label="Mobile navigation"
  >
    <div class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:text-white hover:bg-white/5"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/docs/getting-started/"
        class="block rounded-md px-3 py-2 text-base font-semibold text-accent-400"
      >
        Get Started →
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
