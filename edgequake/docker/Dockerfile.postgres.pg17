# EdgeQuake PostgreSQL 17 — pgvector + contrib FTS extensions (SPEC-042-C)
#
# SSOT extension pins: edgequake/docker/extension-pins.sh (EQ_POSTGRES_PROFILE=pg17)
#   PostgreSQL 17 (bookworm)
#   pgvector     v0.8.5  — https://pgxn.org/dist/vector
#   contrib      pg_trgm, btree_gin, uuid-ossp (postgresql-contrib-17)
# Apache AGE is not in this image. GraphRAG uses the plain eq_graph_* tables.

FROM postgres:17-bookworm

ARG PGVECTOR_VERSION=v0.8.5

LABEL org.edgequake.postgres.version="17-bookworm" \
      org.edgequake.pgvector.version="0.8.5" \
      org.edgequake.extensions="vector,pg_trgm,btree_gin,uuid-ossp"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-17 \
    postgresql-contrib-17 \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    cd /tmp; \
    git clone --depth 1 --branch "${PGVECTOR_VERSION}" https://github.com/pgvector/pgvector.git; \
    cd pgvector; \
    make OPTFLAGS=""; \
    make install; \
    rm -rf /tmp/pgvector

RUN apt-get purge -y --auto-remove \
    build-essential \
    postgresql-server-dev-17 \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    test -f /usr/share/postgresql/17/extension/vector.control; \
    test ! -e /usr/share/postgresql/17/extension/age.control; \
    test -f /usr/share/postgresql/17/extension/pg_trgm.control; \
    test -f /usr/share/postgresql/17/extension/btree_gin.control; \
    test -f /usr/share/postgresql/17/extension/uuid-ossp.control; \
    grep -q "default_version = '0.8.5'" /usr/share/postgresql/17/extension/vector.control

EXPOSE 5432
CMD ["postgres"]
