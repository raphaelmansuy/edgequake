# Rendered on the VM from Secret Manager. Do not commit real values.
EDGEQUAKE_VERSION=0.27.0
EDGEQUAKE_POSTGRES_TAG=0.27.0
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-in-production-256-bit-secret-key
EDGEQUAKE_BOOTSTRAP_ADMIN_PASSWORD=change-me
EDGEQUAKE_MASTER_API_KEY=change-me
# 32-byte envelope key. render-env.sh fills this. Never commit a real value.
# EDGEQUAKE_SECRETS_KEY=
# EDGEQUAKE_SECRETS_KEY_ID=v1
EDGEQUAKE_API_URL=https://203.0.113.10
EDGEQUAKE_CORS_ORIGINS=https://203.0.113.10
EDGEQUAKE_TLS_HOST=203.0.113.10
ELITIZON_DATA_MOUNT=/mnt/elitizon-db-data
# openai when edgequake-openai-api-key is a real key; mistral when only edgequake-mistral-api-key is set
EDGEQUAKE_LLM_PROVIDER=openai
EDGEQUAKE_ALLOW_MOCK_PROVIDER=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# SPEC-160: engine on. Decision Ollama is the host, not the chat LLM.
EDGEQUAKE_DECISION_ENABLED=1
EDGEQUAKE_DECISION_BASE_URL=http://host.docker.internal:11434
# render-originals.sh sets these when edgequake-gcs-originals-key exists.
# Unset keeps the API on database mode.
# EDGEQUAKE_ORIGINAL_STORE=database
# EDGEQUAKE_ORIGINAL_STORE_URL=gs://PROJECT-edgequake-originals/demo
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-originals.json
