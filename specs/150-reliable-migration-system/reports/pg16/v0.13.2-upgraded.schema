CREATE UNIQUE INDEX document_mm_assets_object_id_key ON public.document_mm_assets USING btree (object_id);
CREATE UNIQUE INDEX eq_graph_namespace_ns_uidx ON public.eq_graph_namespace USING btree (namespace);
CREATE UNIQUE INDEX idx_data_bindings_active ON public.data_bindings USING btree (tenant_id, workspace_id, role, COALESCE(model_descriptor, ''::text)) WHERE (state = 'active'::text);
CREATE UNIQUE INDEX idx_document_mm_assets_doc_asset_id ON public.document_mm_assets USING btree (document_id, asset_id);
CREATE UNIQUE INDEX idx_documents_workspace_content_hash_unique ON public.documents USING btree (workspace_id, content_hash) WHERE ((workspace_id IS NOT NULL) AND (content_hash IS NOT NULL) AND ((status)::text = 'indexed'::text));
CREATE UNIQUE INDEX idx_edge_eq_source_target_rel ON eq_eq_default_graph."EDGE" USING btree (eq_source_id, eq_target_id, eq_rel_type) WHERE ((eq_source_id IS NOT NULL) AND (eq_target_id IS NOT NULL) AND (eq_rel_type IS NOT NULL));
CREATE UNIQUE INDEX idx_entity_embeddings_legacy_vector_id ON public.entity_embeddings USING btree (workspace_id, legacy_vector_id) WHERE (legacy_vector_id IS NOT NULL);
CREATE UNIQUE INDEX idx_node_eq_node_id ON eq_eq_default_graph."Node" USING btree (eq_node_id) WHERE (eq_node_id IS NOT NULL);
CREATE UNIQUE INDEX idx_pdf_documents_workspace_checksum_unique ON public.pdf_documents USING btree (workspace_id, sha256_checksum);
CREATE UNIQUE INDEX idx_refresh_tokens_token_hash ON public.refresh_tokens USING btree (token_hash);
CREATE UNIQUE INDEX idx_relationship_embeddings_legacy_vector_id ON public.relationship_embeddings USING btree (workspace_id, legacy_vector_id) WHERE (legacy_vector_id IS NOT NULL);
CREATE UNIQUE INDEX idx_report_embeddings_legacy_vector_id ON public.report_embeddings USING btree (workspace_id, legacy_vector_id) WHERE (legacy_vector_id IS NOT NULL);
CREATE UNIQUE INDEX model_catalog_policy_ceiling_uq ON public.model_catalog_policy USING btree (tenant_id, provider, model, usage) WHERE (workspace_id IS NULL);
CREATE UNIQUE INDEX model_catalog_policy_workspace_uq ON public.model_catalog_policy USING btree (tenant_id, workspace_id, provider, model, usage) WHERE (workspace_id IS NOT NULL);
CREATE UNIQUE INDEX original_object_refs_asset_object_id_key ON public.original_object_refs USING btree (asset_object_id) WHERE (asset_object_id IS NOT NULL);
CREATE UNIQUE INDEX original_object_refs_document_id_key ON public.original_object_refs USING btree (document_id) WHERE (document_id IS NOT NULL);
CREATE UNIQUE INDEX original_object_refs_markdown_object_id_key ON public.original_object_refs USING btree (markdown_object_id) WHERE (markdown_object_id IS NOT NULL);
CREATE UNIQUE INDEX original_object_refs_pdf_id_key ON public.original_object_refs USING btree (pdf_id) WHERE (pdf_id IS NOT NULL);
CREATE UNIQUE INDEX pdf_documents_markdown_object_id_key ON public.pdf_documents USING btree (markdown_object_id);
CREATE UNIQUE INDEX provider_connections_fleet_slug_uq ON public.provider_connections USING btree (slug) WHERE (tenant_id IS NULL);
CREATE UNIQUE INDEX provider_offers_tenant_uq ON public.provider_offers USING btree (tenant_id, provider_slug) WHERE (workspace_id IS NULL);
CREATE UNIQUE INDEX provider_offers_workspace_uq ON public.provider_offers USING btree (tenant_id, workspace_id, provider_slug) WHERE (workspace_id IS NOT NULL);
CREATE UNIQUE INDEX scope_purge_receipts_running_uq ON public.scope_purge_receipts USING btree (scope_kind, scope_id) WHERE (status = 'running'::text);
CREATE UNIQUE INDEX uq_tenant_invitations_open_email ON public.tenant_invitations USING btree (tenant_id, lower(email)) WHERE ((accepted_at IS NULL) AND (revoked_at IS NULL));
CREATE UNIQUE INDEX uq_user_access_links_open ON public.user_access_links USING btree (user_id, purpose) WHERE ((used_at IS NULL) AND (revoked_at IS NULL));
CREATE UNIQUE INDEX workspaces_tenant_id_workspace_id_uq ON public.workspaces USING btree (tenant_id, workspace_id);
