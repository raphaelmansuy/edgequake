CASE
COMMENT ON COLUMN ag_catalog.workspace_metrics_history.storage_bytes IS 'Total storage used by workspace in bytes (sum of document file sizes)';
COMMENT ON COLUMN ag_catalog.workspace_metrics_history.trigger_type IS 'How the sample was triggered: "event" for document operations, "scheduled" for background tasks';
COMMENT ON COLUMN public.chunk_embeddings.embedding IS 'SPEC-091: unconstrained halfvec; length must equal dimensions (CHECK). ANN via dim-scoped expression HNSW (768/1024/1536).';
COMMENT ON COLUMN public.chunks.content_tsv IS 'SPEC-091 RM2: BM25/tsquery lexical index over chunk content (LAW-D6 generated from content).';
COMMENT ON COLUMN public.chunks.context_preamble IS 'SPEC-091 RM2: optional document/section context prepended at embed time when EDGEQUAKE_CONTEXTUAL_CHUNK=on (LAW-RM7 quality contract).';
COMMENT ON COLUMN public.conversations.mode IS 'local | global | hybrid | naive | mix | bypass (Chat; no KG retrieval)';
COMMENT ON COLUMN public.document_mm_assets.asset_id IS 'Stable REST id (filename stem): page-0001 | page-0001-chart — SSOT with drawing_tags::asset_id_from_rel_path';
COMMENT ON COLUMN public.document_mm_assets.asset_kind IS 'page_full | page_chart_crop';
COMMENT ON COLUMN public.document_mm_assets.asset_path IS 'Relative path SSOT from drawing_tags (e.g. assets/page-0001.png)';
COMMENT ON COLUMN public.document_mm_assets.byte_location IS 'database = asset_data present; object = bytes in the originals bucket and asset_data null.';
COMMENT ON COLUMN public.document_mm_assets.object_id IS 'SPEC-172 object owner. The bucket key uses this id, never asset_path or asset_id.';
COMMENT ON COLUMN public.document_mm_assets.page_num IS '1-indexed PDF page for page→asset lineage (matches chunks.page_start)';
COMMENT ON COLUMN public.documents.chunk_count IS 'Denormalized chunk count, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.cost_usd IS 'LLM cost in USD for this document, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.entity_count IS 'Denormalized entity count, refreshed by update_document_stats (SPEC-021 P-A1). SSOT for this fact = AGE graph (INV-C).';
COMMENT ON COLUMN public.documents.error_message IS 'Terminal/partial failure detail, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.fence_epoch IS 'SPEC-120 P0: bumped on delete/wipe/reprocess-supersede; writers must present matching epoch';
COMMENT ON COLUMN public.documents.input_tokens IS 'LLM input tokens, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.output_tokens IS 'LLM output tokens, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.relationship_count IS 'Denormalized relationship count, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.documents.total_tokens IS 'LLM total tokens, refreshed by update_document_stats (SPEC-021 P-A1).';
COMMENT ON COLUMN public.entities.source_chunk_ids IS 'TEXT[] of KV chunk keys that contributed to this entity. Format: "{doc_id}-chunk-{n}". Used for cascade delete. Corresponds to AGE Node.source_ids property.';
COMMENT ON COLUMN public.entities.sync_status IS 'Sync state: unsynced | synced | pending_repair. Set to synced by dual-write in KnowledgeGraphMerger. Set to unsynced on insert (pre-backfill).';
COMMENT ON COLUMN public.entity_embeddings.embedding IS 'SPEC-091: unconstrained halfvec; dim-scoped HNSW (768/1024/1536).';
COMMENT ON COLUMN public.entity_embeddings.legacy_vector_id IS 'SPEC-111: source eq_*_vectors.id from iw2 backfill (drop-guard provenance).';
COMMENT ON COLUMN public.failed_chunks.retry_attempts IS 'Number of retry attempts so far';
COMMENT ON COLUMN public.failed_chunks.status IS 'Retry status: pending, retrying, succeeded, abandoned';
COMMENT ON COLUMN public.failed_chunks.was_timeout IS 'True if failure was due to extraction timeout';
COMMENT ON COLUMN public.messages.feedback_rating IS 'User thumbs: up or down (nullable)';
COMMENT ON COLUMN public.messages.feedback_reason IS 'Optional free-text reason for feedback';
COMMENT ON COLUMN public.messages.finish_reason IS 'Assistant generation finish reason (stop, interrupted, …)';
COMMENT ON COLUMN public.messages.llm_model IS 'LLM model used for this assistant response (lineage)';
COMMENT ON COLUMN public.messages.llm_provider IS 'LLM provider used for this assistant response (lineage)';
COMMENT ON COLUMN public.original_object_refs.chunk_sha256 IS 'Packed SHA-256 digests (32 bytes each) of successive 131072-byte PDF windows. NULL leaves a partial range unchecked.';
COMMENT ON COLUMN public.outbox_events.attempt_count IS 'SPEC-091 RM0: apply attempts; dead after configured max (default 6).';
COMMENT ON COLUMN public.outbox_events.available_at IS 'SPEC-091 RM0: next claim eligibility (backoff after failed apply).';
COMMENT ON COLUMN public.outbox_events.workspace_id IS 'SPEC-091 IP2: optional workspace scope for future isolation/drain filters.';
COMMENT ON COLUMN public.page_layout_regions.bbox_pdf IS 'PDF user-space box {x0,y0,x1,y1}; never store bbox_norm.';
COMMENT ON COLUMN public.pdf_documents.content_type IS 'MIME type (application/pdf)';
COMMENT ON COLUMN public.pdf_documents.created_at IS 'Timestamp when PDF was uploaded';
COMMENT ON COLUMN public.pdf_documents.document_id IS 'Link to processed document (NULL during processing, set when indexed)';
COMMENT ON COLUMN public.pdf_documents.extraction_errors IS 'JSONB with errors/warnings: {"errors": [...], "warnings": [...], "retries": N}';
COMMENT ON COLUMN public.pdf_documents.extraction_method IS 'Method used for extraction: text | vision | hybrid (NULL if not processed)';
COMMENT ON COLUMN public.pdf_documents.file_size_bytes IS 'File size in bytes (for billing, quotas, optimization)';
COMMENT ON COLUMN public.pdf_documents.filename IS 'Original filename from upload (max 512 chars)';
COMMENT ON COLUMN public.pdf_documents.markdown_content IS 'Extracted markdown content (NULL if processing incomplete)';
COMMENT ON COLUMN public.pdf_documents.markdown_location IS 'database = markdown_content may be present; object = markdown bytes in the originals bucket and markdown_content null.';
COMMENT ON COLUMN public.pdf_documents.markdown_object_id IS 'SPEC-172 object owner for extracted markdown. The key uses this id, never the filename.';
COMMENT ON COLUMN public.pdf_documents.page_count IS 'Number of pages in PDF (extracted during initial parse)';
COMMENT ON COLUMN public.pdf_documents.pdf_id IS 'Unique identifier for PDF file';
COMMENT ON COLUMN public.pdf_documents.processed_at IS 'Timestamp when processing completed (NULL if incomplete)';
COMMENT ON COLUMN public.pdf_documents.processing_status IS 'pending | processing | completed | failed | cancelled (SPEC-057)';
COMMENT ON COLUMN public.pdf_documents.sha256_checksum IS 'SHA-256 hash for deduplication and integrity verification';
COMMENT ON COLUMN public.pdf_documents.updated_at IS 'Timestamp of last update';
COMMENT ON COLUMN public.pdf_documents.vision_model IS 'Vision LLM model used: gpt-4o-mini | gemma3:latest | NULL for text-only';
COMMENT ON COLUMN public.pdf_documents.workspace_id IS 'Workspace isolation (MANDATORY). Each PDF belongs to exactly one workspace.';
COMMENT ON COLUMN public.relationship_embeddings.embedding IS 'SPEC-091: unconstrained halfvec; dim-scoped HNSW (768/1024/1536).';
COMMENT ON COLUMN public.relationship_embeddings.legacy_vector_id IS 'SPEC-111: source eq_*_vectors.id from iw2 backfill (drop-guard provenance).';
COMMENT ON COLUMN public.relationships.source_chunk_keys IS 'Legacy chunk keys ("{doc_id}-chunk-{n}") that produced this relationship; same shape as entities.source_chunk_ids. Maps to documents via chunks.legacy_chunk_key.';
COMMENT ON COLUMN public.report_embeddings.embedding IS 'SPEC-091: unconstrained halfvec; dim-scoped HNSW (768/1024/1536).';
COMMENT ON COLUMN public.report_embeddings.legacy_vector_id IS 'SPEC-111: source eq_*_vectors.id from iw2 backfill (drop-guard provenance).';
COMMENT ON COLUMN public.tasks.available_at IS 'SPEC-120 P1: earliest claim time for durable retry backoff; NULL = immediately available';
COMMENT ON COLUMN public.tasks.cancel_requested_at IS 'SPEC-120 P0: durable cancel intent; NULL = not cancelling; set before registry';
COMMENT ON COLUMN public.tasks.circuit_breaker_tripped IS 'Whether circuit breaker has permanently failed this task (3+ consecutive timeouts). Prevents infinite retries.';
COMMENT ON COLUMN public.tasks.consecutive_timeout_failures IS 'Number of consecutive timeout failures (resets to 0 on success or non-timeout failure). Circuit breaker trips at 3.';
COMMENT ON COLUMN public.tasks.document_id IS 'Denormalized from payload task_data/metadata at enqueue (issue #384 INV-07)';
COMMENT ON COLUMN public.tasks.error IS 'Structured error information (TaskFailureInfo): message, step, reason, suggestion, retryable, is_timeout.';
COMMENT ON COLUMN public.tasks.fairness_hold_until IS 'SPEC-057 INV-06: claim_next skips rows while NOW() < fairness_hold_until; NULL = runnable';
COMMENT ON COLUMN public.tasks.job_id IS 'SPEC-120 P2: optional owning job; additive while legacy task APIs remain active';
COMMENT ON COLUMN public.tasks.lease_expires_at IS 'Lease expiry; claimable when status=processing and expired (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks.lease_owner IS 'Worker id holding the processing lease (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks.lease_token IS 'CAS token for refresh_lease / release_claim (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks.parent_task_id IS 'SPEC-120 P2: direct task lineage; PDF Insert follow-on points to Convert track_id';
COMMENT ON COLUMN public.tasks.pdf_id IS 'Denormalized from payload task_data/metadata at enqueue (SPEC-090 F-090-15)';
COMMENT ON COLUMN public.tasks.progress IS 'Task progress snapshot (SPEC-090); prefer this column over payload.progress';
COMMENT ON COLUMN public.tasks.superseded_by IS 'SPEC-120 P0: track_id of replacement task (reprocess/delete); NULL = none';
COMMENT ON COLUMN public.tasks_history.circuit_breaker_tripped IS 'Whether circuit breaker has permanently failed this task (3+ consecutive timeouts). Prevents infinite retries.';
COMMENT ON COLUMN public.tasks_history.consecutive_timeout_failures IS 'Number of consecutive timeout failures (resets to 0 on success or non-timeout failure). Circuit breaker trips at 3.';
COMMENT ON COLUMN public.tasks_history.error IS 'Structured error information (TaskFailureInfo): message, step, reason, suggestion, retryable, is_timeout.';
COMMENT ON COLUMN public.tasks_history.lease_expires_at IS 'Lease expiry; claimable when status=processing and expired (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks_history.lease_owner IS 'Worker id holding the processing lease (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks_history.lease_token IS 'CAS token for refresh_lease / release_claim (SPEC-057 P1)';
COMMENT ON COLUMN public.tasks_history.pdf_id IS 'Denormalized from payload task_data/metadata at enqueue (SPEC-090 F-090-15)';
COMMENT ON COLUMN public.tasks_history.progress IS 'Task progress snapshot (SPEC-090); prefer this column over payload.progress';
COMMENT ON COLUMN public.users.failed_login_attempts IS 'Failed login count — synced from KV auth when postgres mode (SPEC-027 SEC-011)';
COMMENT ON COLUMN public.users.locked_until IS 'Account lockout expiry — synced from KV auth when postgres mode (SPEC-027 SEC-011)';
COMMENT ON EXTENSION "uuid-ossp" IS 'generate universally unique identifiers (UUIDs)';
COMMENT ON EXTENSION age IS 'AGE database extension';
COMMENT ON EXTENSION btree_gin IS 'support for indexing common datatypes in GIN';
COMMENT ON EXTENSION pg_trgm IS 'text similarity measurement and index searching based on trigrams';
COMMENT ON EXTENSION vector IS 'vector data type and ivfflat and hnsw access methods';
COMMENT ON FUNCTION public.current_tenant_id() IS 'Returns the current tenant ID from session context';
COMMENT ON FUNCTION public.current_workspace_id() IS 'Returns the current workspace ID from session context';
COMMENT ON FUNCTION public.edgequake_tasks_status_transition_ok(old_status text, new_status text) IS 'SPEC-120 INV-4: mirrors Rust TaskStatus::allows for DB-side enforcement';
COMMENT ON FUNCTION public.eq_merge_graph_properties(existing jsonb, incoming jsonb) IS 'SPEC-058: merge AGE property maps with source_ids/source_chunk_ids union';
COMMENT ON FUNCTION public.eq_serving_chunk_presence(p_workspace_id uuid) IS 'SPEC-081 C5 admin/debug: relational chunks for workspace with embedding_id link. Not RAG ANN SSOT.';
COMMENT ON FUNCTION public.eq_serving_vector_presence(p_workspace_id uuid, p_vectors_table regclass) IS 'SPEC-081 C5 admin/debug: join chunks to a vectors table. Not RAG ANN SSOT; not a silent store unify.';
COMMENT ON FUNCTION public.set_tenant_context(p_tenant_id uuid, p_workspace_id uuid, p_user_id uuid) IS 'RLS session scope — use with_acquired_tenant_context in API (SPEC-027 SEC-014)';
COMMENT ON INDEX public.idx_tasks_claim_pending_workspace_created IS 'SPEC-090: sargable pending arm for workspace-scoped claim_next SKIP LOCKED';
COMMENT ON INDEX public.idx_tasks_claim_workspace_created IS 'SPEC-084 / GH-316: workspace-fair claim_next (status + workspace + created_at)';
COMMENT ON TABLE ag_catalog.workspace_metrics_history IS 'Time-series storage of workspace metrics for monitoring and analysis. 
COMMENT ON TABLE edgequake.provider_budget IS 'SPEC-091 QW1 (LAW-Q1): one provider budget row per provider — the capacity SSOT the admission resolver derives from.';
COMMENT ON TABLE edgequake.provider_slot IS 'SPEC-091 QW1 (LAW-Q3): cluster-wide provider concurrency slots. Acquire via UPDATE ... FOR UPDATE SKIP LOCKED; TTL + fencing token; reaper reclaims stale leases.';
COMMENT ON TABLE public.api_keys IS 'API key SSOT when PG pool exists. Handlers use session_storage — not auth_kv_store directly.';
COMMENT ON TABLE public.attempts IS 'SPEC-120 P2 lease/attempt audit trail; dual-write is optional during rollout';
COMMENT ON TABLE public.chunk_embeddings IS 'SPEC-091 W3: typed vector authority; halfvec(1536) interim — expand-and-contract per model generation.';
COMMENT ON TABLE public.chunk_serving_state IS 'SPEC-091 W4: query-visible chunks require state=ready when EDGEQUAKE_SERVING_FENCE=on.';
COMMENT ON TABLE public.document_mm_assets IS 'Vision page / chart-crop PNG assets for markdown viewer and multimodal analyze (SPEC-047 durable). Cascade-deletes with document lineage.';
COMMENT ON TABLE public.document_originals IS 'Raw original upload bytes for non-PDF documents (images, text files, etc.)';
COMMENT ON TABLE public.document_page_states IS 'SPEC-151 per-page parse/figures/entities health. Cascade-deletes with documents.';
COMMENT ON TABLE public.document_pages IS 'Per-page PDF geometry for SPEC-128 layout overlay. Cascade-deletes with documents.';
COMMENT ON TABLE public.entities IS 'CQRS read model for entity analytics, FTS, and JOIN queries. Primary source for graph traversal: Apache AGE (see SPEC-021). Populated by dual-write in KnowledgeGraphMerger when entity_sync_mode != disabled. Backfilled from AGE by migration 040 apply script.';
COMMENT ON TABLE public.entity_embeddings IS 'SPEC-091 IW2: typed entity vector authority; halfvec(1536) interim.';
COMMENT ON TABLE public.failed_chunks IS 'Stores failed chunk extractions for retry functionality (SPEC-003)';
COMMENT ON TABLE public.llm_cache IS 'SPEC-091: LLM extraction/keyword/multimodal cache entries (replaces cache KV families). Rows are recomputable — TTL-based expiry allowed.';
COMMENT ON TABLE public.memberships IS 'Workspace rights SSOT. Identity CRUD routes through identity_storage — not auth_kv_store in handlers.';
COMMENT ON TABLE public.outbox_events IS 'SPEC-091 RM0: transactional outbox. Drain (EDGEQUAKE_OUTBOX_DRAIN) claims unprocessed rows with FOR UPDATE SKIP LOCKED; never mutates document status.';
COMMENT ON TABLE public.page_layout_regions IS 'Page-scoped layout regions in PDF user space. bbox_norm is derived at read (LAW-128-4).';
COMMENT ON TABLE public.pdf_document_blobs IS 'SPEC-090: PDF binary + markdown out of pdf_documents row (list stays metadata-only)';
COMMENT ON TABLE public.pdf_documents IS 'Stores raw PDF files with format metadata for vision LLM processing (SPEC-007). PDFs are processed asynchronously and linked to documents table after markdown extraction.';
COMMENT ON TABLE public.refresh_tokens IS 'Session SSOT when PG pool exists. Handlers route via session_storage — not auth_kv_store.';
COMMENT ON TABLE public.relationship_embeddings IS 'SPEC-091 IW2: typed relationship vector authority; halfvec(1536) interim.';
COMMENT ON TABLE public.relationships IS 'CQRS read model for relationship analytics. Primary source for graph traversal: Apache AGE EDGE (see SPEC-021).';
COMMENT ON TABLE public.report_embeddings IS 'SPEC-091 IW2: typed community-report vector authority; report_id is legacy TEXT key.';
COMMENT ON TABLE public.task_events IS 'SPEC-120 P2 append-only task event stream; writers allocate seq per task';
COMMENT ON TABLE public.users IS 'Identity SSOT when PG pool exists. Without pool: in-memory AuthMemoryStore (tests). Authentication never stored in KV auth:* keys.';
COMMENT ON VIEW edgequake.tasks IS 'Alias of public.tasks including fairness_hold_until (SPEC-057 INV-06; refresh after 138)';
CREATE CONSTRAINT TRIGGER trg_org_keeps_an_owner AFTER DELETE OR UPDATE ON public.memberships DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.eq_org_keeps_an_owner();
CREATE EXTENSION IF NOT EXISTS "uuid-ossp" WITH SCHEMA public;
CREATE EXTENSION IF NOT EXISTS age WITH SCHEMA ag_catalog;
CREATE EXTENSION IF NOT EXISTS btree_gin WITH SCHEMA public;
CREATE EXTENSION IF NOT EXISTS pg_trgm WITH SCHEMA public;
CREATE EXTENSION IF NOT EXISTS vector WITH SCHEMA public;
CREATE FUNCTION ag_catalog.create_age_graph_safe(graph_name text) RETURNS text
CREATE FUNCTION ag_catalog.drop_age_graph_safe(graph_name text) RETURNS text
CREATE FUNCTION ag_catalog.get_node_neighbors(p_graph_name text, p_node_id text, p_direction text DEFAULT 'both'::text, p_edge_label text DEFAULT NULL::text) RETURNS TABLE(neighbor_id text, edge_label text, edge_properties jsonb, direction text)
CREATE FUNCTION ag_catalog.is_age_available() RETURNS boolean
CREATE FUNCTION ag_catalog.upsert_graph_edge(p_graph_name text, p_source_id text, p_target_id text, p_label text, p_properties jsonb, p_tenant_id uuid DEFAULT NULL::uuid, p_workspace_id uuid DEFAULT NULL::uuid) RETURNS uuid
CREATE FUNCTION ag_catalog.upsert_graph_node(p_graph_name text, p_node_id text, p_label text, p_properties jsonb, p_tenant_id uuid DEFAULT NULL::uuid, p_workspace_id uuid DEFAULT NULL::uuid) RETURNS uuid
CREATE FUNCTION edgequake.provider_budget_reconcile_slots(p_provider_key text, p_budget integer) RETURNS void
