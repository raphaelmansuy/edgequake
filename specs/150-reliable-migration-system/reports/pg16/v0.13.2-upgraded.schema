CREATE TRIGGER check_document_quota BEFORE INSERT ON public.documents FOR EACH ROW EXECUTE FUNCTION public.check_workspace_quota();
CREATE TRIGGER chunks_bm25_after_delete AFTER DELETE ON public.chunks REFERENCING OLD TABLE AS old_rows FOR EACH STATEMENT EXECUTE FUNCTION public.eq_bm25_after_chunk_delete();
CREATE TRIGGER chunks_bm25_after_insert AFTER INSERT ON public.chunks REFERENCING NEW TABLE AS new_rows FOR EACH STATEMENT EXECUTE FUNCTION public.eq_bm25_after_chunk_insert();
CREATE TRIGGER eq_graph_degree_delete AFTER DELETE ON public.eq_graph_edges REFERENCING OLD TABLE AS old_edges FOR EACH STATEMENT EXECUTE FUNCTION public.eq_graph_degree_on_delete();
CREATE TRIGGER eq_graph_degree_insert AFTER INSERT ON public.eq_graph_edges REFERENCING NEW TABLE AS new_edges FOR EACH STATEMENT EXECUTE FUNCTION public.eq_graph_degree_on_insert();
CREATE TRIGGER eq_graph_degree_node_insert AFTER INSERT ON public.eq_graph_nodes REFERENCING NEW TABLE AS new_nodes FOR EACH STATEMENT EXECUTE FUNCTION public.eq_graph_degree_on_node_insert();
CREATE TRIGGER eq_graph_degree_update AFTER UPDATE ON public.eq_graph_edges REFERENCING OLD TABLE AS old_edges NEW TABLE AS new_edges FOR EACH STATEMENT EXECUTE FUNCTION public.eq_graph_degree_on_update();
CREATE TRIGGER eq_graph_mirror_edge AFTER INSERT OR DELETE OR UPDATE ON eq_eq_default_graph."EDGE" FOR EACH ROW EXECUTE FUNCTION public.eq_graph_mirror_edge();
CREATE TRIGGER eq_graph_mirror_node AFTER INSERT OR DELETE OR UPDATE ON eq_eq_default_graph."Node" FOR EACH ROW EXECUTE FUNCTION public.eq_graph_mirror_node();
CREATE TRIGGER graph_contribution_copy_label BEFORE INSERT ON public.graph_contributions FOR EACH ROW EXECUTE FUNCTION public.graph_contribution_copy_label();
CREATE TRIGGER normalize_edgequake_task_legacy_fields_trigger BEFORE INSERT OR UPDATE ON public.tasks_history FOR EACH ROW EXECUTE FUNCTION public.normalize_edgequake_task_legacy_fields();
CREATE TRIGGER original_object_refs_before_delete BEFORE DELETE ON public.original_object_refs FOR EACH ROW EXECUTE FUNCTION public.original_object_refs_enqueue_delete();
CREATE TRIGGER set_updated_at BEFORE UPDATE ON public.pdf_documents FOR EACH ROW EXECUTE FUNCTION public.trigger_set_updated_at();
CREATE TRIGGER trg_eq_sync_edge_ids BEFORE INSERT OR UPDATE OF properties ON eq_eq_default_graph."EDGE" FOR EACH ROW EXECUTE FUNCTION public.eq_eq_default_graph_eq_sync_edge_ids();
CREATE TRIGGER trg_eq_sync_node_id BEFORE INSERT OR UPDATE OF properties ON eq_eq_default_graph."Node" FOR EACH ROW EXECUTE FUNCTION public.eq_eq_default_graph_eq_sync_node_id();
CREATE TRIGGER trg_llm_cache_touch BEFORE UPDATE ON public.llm_cache FOR EACH ROW EXECUTE FUNCTION public.touch_llm_cache_updated_at();
CREATE TRIGGER trg_projection_cleanup_intents_same_scope BEFORE INSERT OR UPDATE OF tenant_id, workspace_id, binding_id ON public.projection_cleanup_intents FOR EACH ROW EXECUTE FUNCTION public.provider_access_reject_cross_scope_cleanup();
CREATE TRIGGER trg_projection_deliveries_same_scope BEFORE INSERT OR UPDATE OF event_id, binding_id ON public.projection_deliveries FOR EACH ROW EXECUTE FUNCTION public.provider_access_reject_cross_scope_delivery();
CREATE TRIGGER trg_projection_visibility_same_scope BEFORE INSERT OR UPDATE OF tenant_id, workspace_id, binding_id ON public.projection_visibility FOR EACH ROW EXECUTE FUNCTION public.provider_access_reject_cross_scope_visibility();
CREATE TRIGGER trg_tasks_status_transition BEFORE UPDATE OF status ON public.tasks FOR EACH ROW EXECUTE FUNCTION public.edgequake_tasks_enforce_status_transition();
CREATE TRIGGER trg_workspace_quota_guard BEFORE INSERT ON public.workspaces FOR EACH ROW EXECUTE FUNCTION public.eq_workspace_quota_guard();
CREATE TRIGGER trigger_conversations_updated_at BEFORE UPDATE ON public.conversations FOR EACH ROW EXECUTE FUNCTION public.update_conversations_updated_at();
CREATE TRIGGER trigger_documents_updated_at BEFORE UPDATE ON public.documents FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();
CREATE TRIGGER trigger_entities_updated_at BEFORE UPDATE ON public.entities FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();
CREATE TRIGGER trigger_folders_updated_at BEFORE UPDATE ON public.folders FOR EACH ROW EXECUTE FUNCTION public.update_folders_updated_at();
CREATE TRIGGER trigger_messages_updated_at BEFORE UPDATE ON public.messages FOR EACH ROW EXECUTE FUNCTION public.update_messages_updated_at();
CREATE TRIGGER trigger_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();
CREATE TRIGGER trigger_tasks_updated_at BEFORE UPDATE ON public.tasks_history FOR EACH ROW EXECUTE FUNCTION public.update_updated_at_column();
CREATE TRIGGER trigger_tenants_updated_at BEFORE UPDATE ON public.tenants FOR EACH ROW EXECUTE FUNCTION public.update_tenants_updated_at();
CREATE TRIGGER trigger_update_conversation_on_message AFTER INSERT ON public.messages FOR EACH ROW EXECUTE FUNCTION public.update_conversation_on_message();
CREATE TRIGGER trigger_users_updated_at BEFORE UPDATE ON public.users FOR EACH ROW EXECUTE FUNCTION public.update_users_updated_at();
CREATE TRIGGER trigger_workspaces_updated_at BEFORE UPDATE ON public.workspaces FOR EACH ROW EXECUTE FUNCTION public.update_workspaces_updated_at();
CREATE TRIGGER workspaces_rag_profile_immutable BEFORE UPDATE ON public.workspaces FOR EACH ROW EXECUTE FUNCTION public.eq_workspace_profile_immutable();
