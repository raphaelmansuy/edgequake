    CONSTRAINT chunk_embeddings_dimensions_check CHECK (((dimensions > 0) AND (dimensions <= 4000))),
    CONSTRAINT chunk_embeddings_dims_match CHECK ((public.vector_dims(embedding) = dimensions))
    CONSTRAINT chunk_serving_state_state_check CHECK ((state = ANY (ARRAY['declared'::text, 'embedded'::text, 'graphed'::text, 'ready'::text, 'quarantined'::text, 'deleting'::text])))
    CONSTRAINT chunk_terms_tf_check CHECK ((tf > 0))
    CONSTRAINT chunks_source_modality_chk CHECK ((source_modality = ANY (ARRAY['text'::text, 'image'::text])))
    CONSTRAINT clearance_tags_kind_check CHECK ((kind = ANY (ARRAY['classification'::text, 'compartment'::text])))
    CONSTRAINT compensation_quarantine_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'processing'::text, 'failed'::text, 'dead'::text, 'resolved'::text])))
    CONSTRAINT connection_models_model_chk CHECK (((char_length(model) >= 1) AND (char_length(model) <= 256)))
    CONSTRAINT data_bindings_config_ref_check CHECK ((char_length(config_ref) > 0)),
    CONSTRAINT data_bindings_generation_check CHECK ((generation > 0)),
    CONSTRAINT data_bindings_layout_check CHECK ((char_length(layout) > 0)),
    CONSTRAINT data_bindings_physical_index_check CHECK ((char_length(physical_index) > 0)),
    CONSTRAINT data_bindings_provider_check CHECK ((char_length(provider) > 0)),
    CONSTRAINT data_bindings_role_check CHECK ((char_length(role) > 0)),
    CONSTRAINT data_bindings_state_check CHECK ((state = ANY (ARRAY['active'::text, 'draining'::text, 'retired'::text])))
