{
  "name": "@edgequake/mcp-server",
  "version": "0.3.0",
  "description": "MCP stdio bridge for EdgeQuake Graph-RAG (EQ-MCP-1.0 / SPEC-152)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "edgequake-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "edgequake",
    "mcp",
    "model-context-protocol",
    "rag",
    "knowledge-graph",
    "agent-memory"
  ],
  "author": "EdgeQuake Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelmansuy/edgequake.git",
    "directory": "mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "edgequake-sdk": "file:../sdks/typescript",
    "postcss": "^8.5.26",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "hono": ">=4.12.27",
    "@hono/node-server": ">=2.0.5",
    "fast-uri": ">=4.2.2",
    "body-parser": ">=2.3.0",
    "ip-address": ">=10.7.2",
    "qs": ">=6.16.0",
    "proxy-addr": ">=2.0.8",
    "source-map-js": ">=1.2.2",
    "postcss": "^8.5.26",
    "rollup": ">=4.59.0",
    "esbuild": ">=0.28.1"
  }
}
