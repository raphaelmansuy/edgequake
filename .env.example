# EdgeQuake Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration (CRITICAL - READ THIS)
# =============================================================================
# EdgeQuake uses explicit environment variables to determine which LLM provider to use.
#
# RECOMMENDATION: Prefer the canonical EDGEQUAKE_* names below. Compatibility
# aliases (`MODEL_PROVIDER`, `CHAT_MODEL`, `EMBEDDING_PROVIDER`,
# `EMBEDDING_MODEL`, `EMBEDDING_DIMENSION`) are also accepted for migration,
# but the canonical EdgeQuake names take precedence.

# -----------------------------------------------------------------------------
# Workspace Default Models (REQUIRED FOR PREDICTABLE CONFIGURATION)
# -----------------------------------------------------------------------------
# These environment variables define the default provider for all workspaces.
# ALWAYS SET THESE to avoid auto-detection behavior:

EDGEQUAKE_DEFAULT_LLM_PROVIDER=openai
EDGEQUAKE_DEFAULT_LLM_MODEL=gpt-5-mini
EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=openai
EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=1536

# Compatibility aliases (optional; useful when reusing a LightRAG-style env file)
# MODEL_PROVIDER=openai
# CHAT_MODEL=gpt-5-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# SPEC-040 / D-50: Vision LLM for PDF-to-Markdown conversion (edgequake-pdf2md)
# Uses a vision-capable model to extract structured Markdown from PDF page images.
# Leave empty to inherit EDGEQUAKE_LLM_PROVIDER / EDGEQUAKE_DEFAULT_LLM_PROVIDER.
# Prefer local ollama for dev (no cloud spend); set openai/anthropic/mistral explicitly for prod.
EDGEQUAKE_VISION_PROVIDER=
# EDGEQUAKE_VISION_PROVIDER=ollama
# EDGEQUAKE_VISION_MODEL=llava                 # Free, requires local Ollama
# Cloud alternatives (explicit opt-in — do not leave as default in .env.example):
# EDGEQUAKE_VISION_PROVIDER=openai
# EDGEQUAKE_VISION_MODEL=gpt-4.1-nano          # ~$0.02 per 50-page document
# EDGEQUAKE_VISION_MODEL=gpt-4.1-mini          # Higher quality, ~8x cost
# EDGEQUAKE_VISION_MODEL=gpt-4.1               # Highest quality, ~100x cost
# EDGEQUAKE_VISION_PROVIDER=anthropic
# EDGEQUAKE_VISION_MODEL=claude-haiku-4-20250514
# EDGEQUAKE_VISION_PROVIDER=gemini
# EDGEQUAKE_VISION_MODEL=gemini-2.0-flash      # Free tier available

# SPEC-026/047: Pass B inline chart/figure VLM analyze (after PDF page OCR).
# Default: true — Vision analysis runs when upload process_options includes "i".
# Set false to skip chart datapoint extraction while keeping figure images.
VLM_PROCESS_ENABLE=true
# SPEC-128: two-pass VLM figure filter. Default ON whenever a vision LLM exists
# (unset = on). Discards logos/stamps/watermarks; Pass-2 describes kept
# figures/charts into markdown. Set 0/false/off/no to skip and keep all crops.
# EDGEQUAKE_FIGURE_FILTER=0

# SPEC-134: Manuscript page-class profile (handwritten / MFD-scanned PDFs).
# Force page modality: print | manuscript | mixed (unset = auto heuristic).
# EDGEQUAKE_PDF_PAGE_MODALITY=manuscript
# DPI floor for manuscript pages (default 300; range 200–400).
# EDGEQUAKE_PDF_MANUSCRIPT_DPI=300
# max_rendered_pixels floor for manuscript page PNGs (default 3600).
# EDGEQUAKE_PDF_MANUSCRIPT_MAX_PIXELS=3600
# Skip EdgeParse Auto fast-path for manuscript (default true).
# EDGEQUAKE_PDF_MANUSCRIPT_SKIP_EDGEPARSE=true
# SPEC-134 WP-9: grounding verify pass for manuscript-class pages (default ON).
# Judges each page's Markdown against its page render, refines once on a low
# verdict, marks still-low pages with <!-- grounding:low score=... -->.
# Fail-open: judge errors never block ingestion.
# EDGEQUAKE_PDF_MANUSCRIPT_VERIFY=1
# Minimum grounded score 0.0-1.0 before refine/marking (default 0.6).
# EDGEQUAKE_PDF_MANUSCRIPT_VERIFY_MIN=0.6
# SPEC-134 WP-10: route manuscript-class documents to a different vision
# provider/model (e.g. an HTR-capable model). Unset = use the upload/workspace
# vision provider/model. No vendor is hardcoded.
# EDGEQUAKE_VISION_PROVIDER_MANUSCRIPT=openai
# EDGEQUAKE_VISION_MODEL_MANUSCRIPT=gpt-5.2
# SPEC-134 Slice D: per-image binary budget for vision calls (default 3.5MB).
# Oversized page PNGs are re-encoded PNG→JPEG (then downscaled) before the
# provider sees them. `0` disables the guard.
# EDGEQUAKE_VISION_MAX_IMAGE_BYTES=3500000
# Empty-page escalation: re-OCR pages that returned the empty placeholder
# while a page render exists (default ON).
# EDGEQUAKE_PDF_EMPTY_PAGE_RETRY=1
# Local never-stuck Pass B (Ollama/LM Studio): classify-only, figure cap, wall budget.
# Cloud providers ignore these defaults (unlimited specialize unless set explicitly).
# EDGEQUAKE_MULTIMODAL_FAIL_MODE=degraded
# EDGEQUAKE_MM_LOCAL_CLASSIFY_ONLY=1
# EDGEQUAKE_MM_MAX_FIGURES=12
# EDGEQUAKE_MM_PASS_B_TIMEOUT_SECS=600
# EDGEQUAKE_MM_PASS_B_PAGE_TIMEOUT_SECS=90

# Alternative: Use Ollama for local development
# EDGEQUAKE_DEFAULT_LLM_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_LLM_MODEL=gemma4:latest
# EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=embeddinggemma:latest
# EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=768

# -----------------------------------------------------------------------------
# Option 1: OpenAI (Cloud-hosted, requires API key)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: custom endpoint
# EDGEQUAKE_ALLOW_GATEWAY_MODEL_IDS=1  # Allow slash gateway model IDs (e.g. deepinfra/minimax-m2.5) on cloud providers

# Default OpenAI Models:
#   - Chat/LLM: gpt-5-mini
#   - Embedding: text-embedding-3-small (1536 dimensions)

# -----------------------------------------------------------------------------
# Option 2: Ollama (Local/remote, self-hosted) - RECOMMENDED FOR DEVELOPMENT
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest                  # Chat model (vision-capable)
# OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest # Embedding model (768 dimensions)
# Cap Ollama num_ctx for extraction (EdgeQuake forces this on every /api/chat call).
# Default in make dev is 8192. Raise to 16384–32768 only if needed; unset → 131072 (slow).
OLLAMA_CONTEXT_LENGTH=8192
# Local extraction resilience (serial by default — matches Ollama -np 1):
# EDGEQUAKE_CHUNK_TIMEOUT_SECS=600
EDGEQUAKE_MAX_CONCURRENT_EXTRACTIONS=1
EDGEQUAKE_PROVIDER_BUDGET=1
EDGEQUAKE_LOCAL_MAX_INFLIGHT=1
# Ollama/LM Studio only (`think:false`). Do NOT set `none` for OpenAI/OpenRouter —
# many endpoints reject disable ("Reasoning is mandatory and cannot be disabled").
EDGEQUAKE_EXTRACT_REASONING_EFFORT=none
# EDGEQUAKE_LLM_TIMEOUT_SECS=900
# See docs/operations/local-extract-reliability.md

# Default Ollama Models (set in models.toml):
#   - Chat/LLM: gemma4:latest (vision support; keep OLLAMA_CONTEXT_LENGTH modest for NER)
#   - Embedding: embeddinggemma:latest (768 dimensions)

# -----------------------------------------------------------------------------
# Hybrid Provider Mode: Separate embedding host (closes GitHub issue #140)
# Use a dedicated Ollama node for embeddings while a different provider handles LLM.
# Priority: EDGEQUAKE_EMBEDDING_PROVIDER > OLLAMA_EMBEDDING_HOST > default
# -----------------------------------------------------------------------------
# Separate Ollama host exclusively for embedding generation
# OLLAMA_EMBEDDING_HOST=http://gpu-embedding-server:11434

# Explicitly select an embedding provider (overrides OLLAMA_EMBEDDING_HOST)
# EDGEQUAKE_EMBEDDING_PROVIDER=ollama     # ollama | openai | lmstudio | mock
# EDGEQUAKE_EMBEDDING_MODEL=nomic-embed-text
# EDGEQUAKE_EMBEDDING_DIMENSION=768

# SPEC-083 X-08: SSOT embedding input-count clamp (min'd once with provider.max_batch_size).
# Unset = provider default (OpenAI/trait 2048, Mistral provider 256, …).
# Set explicitly for stricter backends (e.g. TEI=32, some Mistral deployments=16).
# EDGEQUAKE_EMBEDDING_BATCH_SIZE=256

# SPEC-083 D-31: relation weight merge policy (max | mean). Default max (associative).
# EDGEQUAKE_WEIGHT_POLICY=max

# Example — OpenAI for LLM, Ollama on a dedicated GPU box for embeddings:
# EDGEQUAKE_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OLLAMA_EMBEDDING_HOST=http://gpu-box:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# SPEC-057 P2: extract provider for worker fairness clamp (hybrid-aware).
# When LLM is cloud but extract runs on Ollama, set this so local concurrency clamps apply:
# EDGEQUAKE_EXTRACT_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_EXTRACT_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Option 3: MiniMax (Cloud-hosted, OpenAI-compatible API)
# -----------------------------------------------------------------------------
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_BASE_URL=https://api.minimax.io/v1  # Optional: default is https://api.minimax.io/v1
# For China mainland, use: https://api.minimaxi.com/v1

# Default MiniMax Models (set in models.toml):
#   - Chat/LLM: MiniMax-M2.7 (204K context, latest flagship model)
#   - Fast: MiniMax-M2.7-highspeed (204K context, low-latency)
#   - Legacy: MiniMax-M2.5, MiniMax-M2.5-highspeed

# -----------------------------------------------------------------------------
# Option 5: Mistral AI (Cloud-hosted, La Plateforme) - RECOMMENDED FOR PRODUCTION
# Get your key at: https://console.mistral.ai
# -----------------------------------------------------------------------------
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_BASE_URL=https://api.mistral.ai/v1  # Optional: default endpoint

# To make Mistral the default LLM + embedding provider:
# EDGEQUAKE_LLM_PROVIDER=mistral
# EDGEQUAKE_DEFAULT_LLM_MODEL=mistral-small-latest   # cost-effective default

# To use native Mistral embeddings (1024 dimensions):
# EDGEQUAKE_EMBEDDING_PROVIDER=mistral
# MISTRAL_EMBEDDING_MODEL=mistral-embed              # 1024-dimensional vectors

# To use Mistral's vision model for PDF ingestion:
# EDGEQUAKE_VISION_PROVIDER=mistral
# EDGEQUAKE_VISION_MODEL=pixtral-large-latest        # flagship PDF/image model

# Full Mistral stack example (LLM + embedding + vision):
# MISTRAL_API_KEY=your-mistral-api-key-here
# EDGEQUAKE_LLM_PROVIDER=mistral
# EDGEQUAKE_DEFAULT_LLM_MODEL=mistral-small-latest
# EDGEQUAKE_EMBEDDING_PROVIDER=mistral
# MISTRAL_EMBEDDING_MODEL=mistral-embed
# EDGEQUAKE_VISION_PROVIDER=mistral
# EDGEQUAKE_VISION_MODEL=pixtral-large-latest

# Available Mistral models:
#   LLM:      mistral-small-latest, mistral-medium-latest, mistral-large-latest
#   Reasoning: magistral-small-latest, magistral-medium-latest
#   Code:      codestral-latest, devstral-latest
#   Vision:    pixtral-large-latest (recommended for PDF), pixtral-12b-2409
#   Embedding: mistral-embed (1024d), codestral-embed (1024d)

# -----------------------------------------------------------------------------
# Option 4: LM Studio (Local, OpenAI-compatible API)
# -----------------------------------------------------------------------------
# LMSTUDIO_HOST=http://localhost:1234
# LMSTUDIO_MODEL=gemma2-9b-it                # Chat model
# LMSTUDIO_EMBEDDING_MODEL=nomic-embed-text  # Embedding model
# LMSTUDIO_EMBEDDING_DIM=768                 # Embedding dimension

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL is required for server mode.
# Format: postgresql://username:password@host:port/database
# WHY ?options=-c%20search_path%3Dpublic: Forces search_path=public at the
# connection level. Without this, sqlx-cli uses the edgequake schema for
# _sqlx_migrations tracking (because "$user"=edgequake schema exists after
# migration 001), causing duplicate-key errors on every restart.
# DATABASE_URL=postgresql://edgequake:edgequake_secret@localhost:5432/edgequake?options=-c%20search_path%3Dpublic

# SPEC-083 / P0: when AGE eq_* columns are missing after M092, allow /ready and
# use property-path COALESCE SQL instead of refusing traffic (ops escape hatch).
# EDGEQUAKE_EQ_ID_FALLBACK=1

# SPEC-083 / P0: planned large-graph maintenance window for M092 eq_* DDL.
# Sets lock_timeout=120s and ctid-batched NULL-only backfill in support/092.
# Pause heavy query/ingest first — see docs/083-improvements/INCIDENT-PROD-DIAGNOSIS.md
# EDGEQUAKE_EQ_MAINTENANCE=1
# EDGEQUAKE_GRAPH_DDL_LOCK_TIMEOUT=120s

# SPEC-083 / X-19: worker in-flight byte admission budget (0 disables).
# EDGEQUAKE_ADMISSION_MAX_IN_FLIGHT_BYTES=536870912

# SPEC-083 / X-31: shutdown drain budget (seconds). After SIGTERM/Ctrl+C, cancel
# in-flight work and force exit when this budget elapses (default 30).
# EDGEQUAKE_SHUTDOWN_DRAIN_SECS=30

# SPEC-083 / D-51: max files per multipart batch upload (default 20).
# EDGEQUAKE_MAX_BATCH_UPLOAD_FILES=20

# SPEC-083 / X-17: optional fuzzy entity resolution (blocking + Levenshtein/Jaccard).
# Default OFF — exact EntityId only. Set to 1 to enable near-duplicate collapse.
# EDGEQUAKE_ENTITY_FUZZY=1
# EDGEQUAKE_ENTITY_FUZZY_THRESHOLD=0.88

# SPEC-083 / D-54: Louvain phase-2 hierarchy (community aggregation levels).
# Default OFF — flat phase-1 only. Set to 1 to enable multi-level hierarchy.
# EDGEQUAKE_LOUVAIN_HIERARCHY=1

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
# Do NOT set PORT for local `make dev` — ports are auto-assigned in
# .edgequake-dev-ports.env (default backend 8090, frontend 3010).
# PORT=8080

# =============================================================================
# PDF Extraction Configuration
# =============================================================================
# pdfium is embedded via edgequake-pdf2md/pdfium-auto (chromium/7961).
# Env SSOT: PDFIUM_AUTO_CACHE_DIR (extract cache), PDFIUM_LIB_PATH (skip extract).
# Legacy PDFIUM_DYNAMIC_LIB_PATH is unused. Set EDGEQUAKE_SKIP_PDFIUM_PRIME=1 only for
# non-PDF boots (default: prime at startup — SPEC-095).
# PDFIUM_AUTO_CACHE_DIR=/tmp/edgequake-pdfium-cache
# PDFIUM_LIB_PATH=/usr/local/lib/libpdfium.so
# EDGEQUAKE_SKIP_PDFIUM_PRIME=0

# =============================================================================
# Worker Configuration
# =============================================================================
# Number of background workers for document processing
WORKER_THREADS=4
# Max concurrent **ingest** tasks per tenant (Pdf/Insert fairness lane).
# Default ≈ ¾ of WORKER_THREADS. Set 0 to disable the ingest lane.
# Local LLM providers (ollama/lmstudio) clamp workers to 4 and ingest to 2 unless
# EDGEQUAKE_ALLOW_LOCAL_HIGH_CONCURRENCY=1 — even if extraction uses another model.
# MAX_TASKS_PER_TENANT=3
# Max concurrent **lifecycle** tasks per tenant (Deletion/Wipe lane).
# Local default 4 (separate from ingest so deletes do not starve uploads).
# Cloud default matches MAX_TASKS_PER_TENANT. Set 0 to disable the lifecycle lane.
# MAX_LIFECYCLE_TASKS_PER_TENANT=4
# EDGEQUAKE_ALLOW_LOCAL_HIGH_CONCURRENCY=0
# Boot resume policy (SPEC-054 / SPEC-057 P1): default is ON (code) — stale
# Processing is reclaimed to Pending and claimable. Set =0 to mark Interrupted
# Failed and require Reprocess. Pending always survives via SKIP LOCKED.
# EDGEQUAKE_STARTUP_AUTO_RESUME=1
# EDGEQUAKE_STARTUP_RECONCILE_MAX=32
# Task lease TTL for claim_next (seconds, min 30, default 120). Heartbeat refreshes every 60s.
# EDGEQUAKE_TASK_LEASE_TTL_SECS=120
# SPEC-057 P3 multi-replica: set when running >1 API/worker process against shared Postgres.
# When EDGEQUAKE_REPLICAS>1, Local delivery is forbidden — boot fails until you set
# EDGEQUAKE_TASK_DELIVERY=bridged (or notify_only). Correctness SSOT remains claim_next+lease;
# bridged/notify_only are wake modes only (never process from channel payload alone).
# EDGEQUAKE_REPLICAS=1
# EDGEQUAKE_TASK_DELIVERY=local
# Store contention SLOs (queue-metrics + /ready blockers):
# EDGEQUAKE_DB_POOL_UTIL_WARN=0.75
# EDGEQUAKE_DB_POOL_UTIL_CRITICAL=0.90
# EDGEQUAKE_COMPENSATION_QUARANTINE_WARN=1
# EDGEQUAKE_COMPENSATION_QUARANTINE_CRITICAL=5
# Native AGE upserts (ON CONFLICT via M083 UNIQUE) — default ON for best ingest
# latency. Set 0 to force Cypher MERGE fallback.
# EDGEQUAKE_NATIVE_GRAPH_WRITES=1
# Graph query statement_timeout (seconds). DDL uses statement_timeout=0 separately.
# EDGEQUAKE_GRAPH_QUERY_TIMEOUT_SECS=15
# SPEC-071: residual legacy source-prefix SeqScan (LIKE / source_chunk_ids). Default OFF —
# modern discovery uses child "Node"/"EDGE" GIN on source_ids. Set 1 only for pre-source_ids graphs.
# EDGEQUAKE_SOURCE_PREFIX_LEGACY=0
# SPEC-069/070: short lock wait for boot/reconcile AGE + vector DDL (never apply query timeout to DDL).
# EDGEQUAKE_GRAPH_DDL_LOCK_TIMEOUT=5s
# SPEC-070: session maintenance_work_mem for HNSW/IVFFlat/GIN index builds (build connection only).
# EDGEQUAKE_INDEX_MAINTENANCE_WORK_MEM=256MB
# Mix intent arm gate (default ON = Factual→naive-only). Set false for LR-like
# always-on local+global+naive (required for fair GraphRAG-Bench Acc vs LightRAG mix).
# EDGEQUAKE_MIX_ARM_GATE=true

# Chunk sizing SSOT (ingest). Adaptive ON by default (1200→800→600 by doc bytes).
# Fair Acc vs LightRAG: set ADAPTIVE=0 + CHUNK_SIZE=1200 + OVERLAP=100 on the *server*
# before force-ingest (make Acc targets export these).
# EDGEQUAKE_ADAPTIVE_CHUNKING=1
# EDGEQUAKE_CHUNK_SIZE=1200
# EDGEQUAKE_CHUNK_OVERLAP=100
# SPEC-125: markdown packs sibling headings to the token budget (default ON).
# Set 0 to restore heading-hard splits (orphan ## chunks).
# EDGEQUAKE_MARKDOWN_PACK=1
# SPEC-135: PDF converted markdown packs to the token budget (default ON).
# EDGEQUAKE_PDF_PACK=0 restores pre-135 Recursive inner.
# EDGEQUAKE_PDF_CROSS_PAGE_PACK=0 keeps hard page emit (no page_start/page_end span).

# Mix fusion (SPEC-086 E2-occ product default = round_robin / LightRAG Mix identity).
# Ablations: rrf | max_after_minmax (legacy alias: weighted).
# EDGEQUAKE_MIX_FUSION=round_robin
# EDGEQUAKE_HYBRID_FUSION=round_robin
# Graph walk: bfs (default, E2-occ) | ppr (HippoRAG ablation)
# EDGEQUAKE_GRAPH_WALK=bfs
# Entity prompt order: retrieval (default, E2-occ) | query_score | degree
# EDGEQUAKE_ENTITY_RANK=retrieval
# KG→chunk LightRAG Step-3 + VECTOR budget (product default on).
# EDGEQUAKE_KG_CHUNK_OCCURRENCE_SORT=1
# EDGEQUAKE_KG_CHUNK_PICK_LR_BUDGET=1
# Postgres FTS language config for ts_rank_cd / websearch_to_tsquery (X-05; default english)
# EDGEQUAKE_FTS_LANGUAGE=english
# SPEC-096: Fleet default for KG extraction natural-language output (LightRAG SUMMARY_LANGUAGE analogue).
# Workspace metadata `extraction_language` overrides this. Allowlisted display names:
# English, Chinese, Japanese, Korean, Spanish, French, German, Portuguese, Italian, Russian.
# EDGEQUAKE_EXTRACTION_LANGUAGE=English
# KG-linked chunks per entity/relation (LightRAG parity; default 5)
# EDGEQUAKE_RELATED_CHUNK_NUMBER=5
# SPEC-001 Phase 1: post-RRF relevancy prune (default off; Acc gate ctx_rel≥0.50 not met yet)
# EDGEQUAKE_MIX_RELEVANCY_PRUNE=0
# EDGEQUAKE_MIX_RELEVANCY_SCORE=rrf   # or cosine (query↔chunk embed rescore)
# EDGEQUAKE_MIX_RELEVANCY_KEEP=12
# EDGEQUAKE_MIX_RELEVANCY_MIN_KEEP=8
# EDGEQUAKE_MIX_RELEVANCY_SCORE_FLOOR=0.25
# EDGEQUAKE_MIX_GRAPH_SOFT_PRUNE=0
# EDGEQUAKE_MIX_RELEVANCY_EMBED_CHARS=2000
# Filtered HNSW iterative_scan mode (pgvector ≥0.8): relaxed_order | strict_order | off
# EDGEQUAKE_HNSW_ITERATIVE_SCAN=relaxed_order
# HNSW ef_construction for *new* indexes only (default 64 = pgvector; production: 128).
# Existing indexes need operator REINDEX CONCURRENTLY — never rebuilt on boot.
# EDGEQUAKE_HNSW_EF_CONSTRUCTION=128
# SPEC-058: Mix/Hybrid in-flight arm concurrency (default 4).
# For SPEC-001 parallel mix queries, raise toward ≥3× BENCH001_QUERY_CONCURRENCY (021 F3).
# EDGEQUAKE_QUERY_ARM_CONCURRENCY=16
# SPEC-001: fair in-flight mix queries per SUT (EQ ThreadPool + LR asyncio).
# BENCH001_QUERY_CONCURRENCY=8
# 021 F1: global chunk floor (intent also raises Exploratory/Relational/Comparative ≥0.60).
# EDGEQUAKE_MIN_CHUNK_BUDGET_RATIO=0.40
# 021 F2 / 022 P2 path_pack: path-serialized multi-hop (default flat).
# Acc headline: PATH_PRUNE=0 (never BM25+path alone — T011703Z Acc loss).
# Soft path only with CE+protect: PATH_PRUNE=1 + FRACTION=0.4.
# EDGEQUAKE_CONTEXT_FORMAT=flat
# 028 A1: relation-first pack (Relations → Entities → Chunks) under Acc P2b.
# EDGEQUAKE_CONTEXT_FORMAT=rr_cer
# 028 A2: prefer heuristic Factual when LLM returns exploratory/relational (Fact coverage).
# EDGEQUAKE_INTENT_FACTUAL_BIAS=0
# 028 A3: LightRAG-like rag_response answer prompt (Acc ablation).
# EDGEQUAKE_ANSWER_PROMPT=default
# 046/047: specific = name Context entities; SPECIFIC_TYPES=complex scopes to Complex only.
# EDGEQUAKE_ANSWER_PROMPT=specific
# EDGEQUAKE_ANSWER_SPECIFIC_TYPES=complex
# 048: Summarize-only CONTENT materialize (type-routed CE_GAP; empty TYPES = all).
# EDGEQUAKE_TOPIC_MATERIALIZE_TYPES=summarize
# 030 B2 Acc force-ingest (bench001 client): markdown breadcrumbs + gleaning.
# BENCH001_CHUNK_STRATEGY=markdown
# BENCH001_ENABLE_GLEANING=1
# BENCH001_MAX_GLEANING=1
# 031 B3a: lift inline FAQ cues into ## headings before markdown chunking (Acc labeled).
# EDGEQUAKE_STRUCTURE_INDUCE=faq
# BENCH001_STRUCTURE_INDUCE=faq

# EDGEQUAKE_PATH_PRUNE=0
# EDGEQUAKE_PATH_PRUNE_FRACTION=0
# 021 F4 labeled HippoRAG2-style passage-first packing (never Acc silent default).
# EDGEQUAKE_PASSAGE_PACK=0
# 022 P1 graph-walk context compression (labeled; Acc default off).
# EDGEQUAKE_GRAPH_WALK_COMPRESS=0
# 022 P2 LightRAG-like content headings in chunk headers.
# EDGEQUAKE_CONTENT_HEADINGS=0
# 022 P2 entity prompt order: retrieval (default) | query_score | degree.
# EDGEQUAKE_ENTITY_RANK=retrieval
# 051 Local relation select: default (PPR/BFS) | lightrag (incident edges by rank+weight).
# EDGEQUAKE_RELATION_SELECT=default
# 022 P3 keyword lexical boost + Acc disables popular-node hub fallback.
# EDGEQUAKE_KEYWORD_LEXICAL_BOOST=0
# EDGEQUAKE_POPULAR_NODE_FALLBACK=0
# 026 L2 dual-list: API sources = Mix[:K] ∪ CE prompt chunks (Acc labeled; default off).
# EDGEQUAKE_L2_SOURCES_UNION=0
# EDGEQUAKE_L2_SOURCES_MIX_TOP_K=30
# 027 Fact→BM25 on prompt when query_intent=factual (Acc tax — prefer L2_BM25_UNION).
# EDGEQUAKE_FACT_RERANKER=bm25
# EDGEQUAKE_INTENT_RERANK=0
# 058 C1a product latency: Fact CE-skip (alias of Fact→BM25). Acc Fact peer keeps CE.
# EDGEQUAKE_FACT_CE_SKIP=0
# make bench001-c1a  # latency peer on warm Acc WS — not Acc promote
# 059 C1b: BM25-all (no CE) + keyword_time_ms stage honesty — not Acc promote.
# make bench001-c1b
# 060 C1d: product KEYWORD fast path (heuristic = skip keyword LLM). Acc keeps llm.
# EDGEQUAKE_KEYWORD_MODE=llm
# make bench001-c1d
# 062 C1e: LightRAG KEYWORD role via process env (fast model ≠ Query). Acc default empty.
# EDGEQUAKE_KEYWORD_LLM_PROVIDER=mistral
# EDGEQUAKE_KEYWORD_LLM_MODEL=ministral-3b-latest
# make bench001-c1e
# 086 Phase B: EXTRACT≠QUERY ingest (schema-strong extract; Acc QUERY pin unchanged).
# EDGEQUAKE_EXTRACT_LLM_PROVIDER=mistral
# EDGEQUAKE_EXTRACT_LLM_MODEL=mistral-medium-latest
# 063 fair cold latency: disable LightRAG keyword+answer LLM cache (default on = warm Acc unfair).
# BENCH001_LR_ENABLE_LLM_CACHE=1
# make bench001-c1cold
# SPEC-103 / 064: LightRAG-parity LLM cache (keywords + query answers → public.llm_cache).
# Master default ON for product. Acc Acc / c1cold pin EDGEQUAKE_LLM_CACHE=0 (LAW-C7).
# EDGEQUAKE_LLM_CACHE=1
# Fine overrides (optional):
# EDGEQUAKE_KEYWORD_CACHE=1
# EDGEQUAKE_QUERY_ANSWER_CACHE=1
# Acc Fact / c1cold: start_acc_backend exports EDGEQUAKE_LLM_CACHE=0.
# SPEC-126: provider KV / prompt-cache (prefix reuse). Default ON. Does NOT skip
# generation (unlike SPEC-103). Acc should leave this on — answers unchanged.
# EDGEQUAKE_PROMPT_CACHE=1
# Anthropic/Bedrock breakpoint TTL: 5m (default, 1.25× write) or 1h (2.0× write).
# EDGEQUAKE_PROMPT_CACHE_TTL=5m
# SPEC-109: reasoning effort (clamp in edgequake-llm; structured roles → lowest supported).
# EDGEQUAKE_REASONING_EFFORT=minimal
# EDGEQUAKE_EXTRACT_REASONING_EFFORT=minimal
# EDGEQUAKE_QUERY_REASONING_EFFORT=
# EDGEQUAKE_VLM_REASONING_EFFORT=minimal
# EDGEQUAKE_SUMMARY_REASONING_EFFORT=minimal
# EDGEQUAKE_KEYWORD_REASONING_EFFORT=minimal
# SPEC-131 / #379: omit illegal sampling params (Gemma 4 / Grok 4.3 on Bedrock Mantle).
# EDGEQUAKE_LLM_OMIT_TEMPERATURE=true
# EDGEQUAKE_LLM_OMIT_REASONING_EFFORT=true
# Upstream transport: chat_completions (default) | responses (GPT-5.6 Mantle, store:false).
# EDGEQUAKE_LLM_API_FORMAT=chat_completions
# Example — Bedrock Mantle Gemma (Chat Completions, omit temperature):
# EDGEQUAKE_LLM_PROVIDER=openai
# EDGEQUAKE_LLM_MODEL=google.gemma-4-31b
# OPENAI_BASE_URL=https://bedrock-mantle.<region>.api.aws/openai/v1
# EDGEQUAKE_LLM_OMIT_TEMPERATURE=true
# Example — Bedrock Mantle GPT-5.6 (Responses API):
# EDGEQUAKE_LLM_MODEL=openai.gpt-5.6-luna
# EDGEQUAKE_LLM_API_FORMAT=responses
# EDGEQUAKE_LLM_OMIT_TEMPERATURE=true
# 027b / 086 E2-occ: L2 citations = BM25(Mix)∪CE Fact-replace (product default on).
# EDGEQUAKE_L2_BM25_UNION=1
# EDGEQUAKE_L2_BM25_MIX_TOP_K=30
# EDGEQUAKE_L2_BM25_MODE=fact_replace
# 080 D1 R6: Acc prompt chunks == Fact L2 citations (LightRAG one-list). Labeled packs only.
# EDGEQUAKE_L2_BM25_MODE=unified
# make bench001-lr-unify-fact-l2
# 080 D2: tilt Mix fusion weights by query_intent (Fact→naive-heavy). Arms stay always-on.
# EDGEQUAKE_MIX_INTENT_WEIGHTS=0
# make bench001-lr-intent-w-fact-l2
# 080 D3 last-resort (historically Acc REJECT): RELATION_SELECT=lightrag
# EDGEQUAKE_RELATION_SELECT=default
# make bench001-lr-relsel-fact-l2
# 080 D0 forensics (no Acc run):
# make bench001-d0-forensics


# EDGEQUAKE_PPR_DAMPING=0.85
# EDGEQUAKE_PPR_MAX_ITERS=20
# SPEC-001: official judge in-flight samples (default 16; max 64). Gen∥retrieval + qtypes parallel.
# BENCH001_EVAL_CONCURRENCY=16
# Larger SUT+judge ablation: make bench001-smoke-fast-large (mistral-large-latest, eval=24).
# SPEC-001 provider pins (defaults = mistral-small-latest + mistral-embed).
# CLI flags (--llm-model, --judge-model, …) override these. Recorded in scorecard pins.lineage.
# BENCH001_LLM_PROVIDER=mistral
# BENCH001_LLM_MODEL=mistral-small-latest
# BENCH001_VISION_PROVIDER=mistral
# BENCH001_VISION_MODEL=mistral-small-latest
# BENCH001_EMBEDDING_PROVIDER=mistral
# BENCH001_EMBEDDING_MODEL=mistral-embed
# BENCH001_EMBEDDING_DIM=1024
# BENCH001_LLM_BASE_URL=https://api.mistral.ai/v1
# Judge LLM (defaults to SUT LLM). Metric embed defaults to mistral-embed (Acc cosine term).
# BENCH001_JUDGE_PROVIDER=mistral
# BENCH001_JUDGE_MODEL=mistral-small-latest
# BENCH001_JUDGE_BASE_URL=https://api.mistral.ai/v1
# BENCH001_JUDGE_EMBEDDING_MODEL=mistral-embed
# Paper parity metric embed: BAAI/bge-large-en-v1.5 + BENCH001_JUDGE_EMBED_BACKEND=hf_bge
# BENCH001_JUDGE_EMBED_BACKEND=auto
# BENCH001_JUDGE_TEMPERATURE=0.0
# Acc = w*statement_F1 + (1-w)*embed_cosine  (upstream default w=0.75)
# BENCH001_ACC_FACTUALITY_WEIGHT=0.75
# SUT answer style: gold (default for Acc F1) | concise | default | verbose
# BENCH001_ANSWER_STYLE=gold
# SPEC-058: allow DROP+recreate of vector tables on embedding dim mismatch (default off).
# EDGEQUAKE_ALLOW_VECTOR_TABLE_REBUILD=0
# SPEC-058: non-empty dim mismatch never silent-DROP. Boot PreferExisting keeps
# stored default-table dim so Acc/workspace tables stay reachable when .env
# embedding (e.g. ollama 768) differs from default table (e.g. mistral 1024).
# Workspace open stays fail-closed. Empty tables may recreate without this flag.
# SPEC-059: retract ANN/graph indexes when orphan recovery marks mid-saga docs failed (default on).
# EDGEQUAKE_ORPHAN_RETRACT_ON_RECOVER=1
# --- Recipe: default (≤50k vectors) ---
# No vector flags required. Size Postgres shared_buffers ≥2GB for Mix/ANN stress.
# See docs/product-limits.md "Pick your size".
#
# =============================================================================
# Greenfield Wave-2 turnkey (SPEC-071) — opt-in; no silent prod default
# =============================================================================
# One-liner (prints exports):  make wave2-greenfield-env
# Or:  WAVE2_GREENFIELD=1 make backend-bg   /   WAVE2_GREENFIELD=1 make dev
# Warmup after data load:      ./scripts/wave2_warmup.sh <workspace_uuid>
#                              POST /api/v1/admin/ann/warmup  {"workspace_ids":["…"]}
# /ready with Wave-2 on = catalog ANN presence (not plan-shape). See docs/product-limits.md.
#
# EDGEQUAKE_VECTOR_STORAGE=halfvec
# EDGEQUAKE_HNSW_PARTIAL_BY_WORKSPACE=1
# EDGEQUAKE_HNSW_PARTIAL_MIN_ROWS=1000
# EDGEQUAKE_METADATA_FILTER_COLUMNS_ONLY=1
# Concurrent tip @100k (SPEC-068) — NOT the silent product clamp default:
# EDGEQUAKE_HNSW_EF_SEARCH=240
# Do not use higher ef_search to market >100k (mid-scale wall — make recall-pareto).
#
# Host residency: laptop/CI ≥2GB shared_buffers; lab L2 ≥4GB (docs/product-limits.md).
# Claim gates (not day-2 sizing): make ceiling-proof · make recall-pareto · make dedicated-midscale · make product-limits-check
# Dedicated WS tables = dimension isolation (SPEC-069); not part of turnkey 100k path.
# DiskANN / pgvectorscale = SPEC-070 opt-in study only (make diskann-battle); not default.
#
# SPEC-061/062: inviolable DataAccess p95/EXPLAIN/stress on PG16/17/18 (pinned AGE+pgvector):
#   make data-access-perf-matrix
#   make data-access-perf-matrix-release   # cargo --release
#   make compare-eq-perf                   # cross-major ≤2× on archived JSONL
# Artifacts: /tmp/eq-perf-{pg16,pg17,pg18}.jsonl

# =============================================================================
# API Security (SPEC-027) — production hardening
# =============================================================================
# Auth is ON by default (AC-4 phase 44). For local open API without login:
#   EDGEQUAKE_DEV_MODE=true          # recommended for make dev / local only
#   EDGEQUAKE_AUTH_ENABLED=false     # explicit opt-out (legacy)
# Migration checksum repair (LAW-MIG) — prefer scoped allowlist over DEV_MODE:
#   EDGEQUAKE_ALLOW_CHECKSUM_REPAIR=71,78,118,121,125,131
#   (make_dev migrate sets this automatically; unset in production serving)
# When auth is off, chat uses one shared per-tenant guest (SPEC-087 / #335).
# Set false to refuse unauthenticated chat/conversation create (no guest INSERT):
# EDGEQUAKE_ALLOW_ANONYMOUS=true
# EDGEQUAKE_DEV_MODE=true
# EDGEQUAKE_MASTER_API_KEY=your-bootstrap-key
# EDGEQUAKE_BOOTSTRAP_ADMIN_USERNAME=admin
# EDGEQUAKE_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# EDGEQUAKE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# EDGEQUAKE_API_KEYS=key1,key2
# JWT_SECRET=your-256-bit-secret-here
# EDGEQUAKE_STRICT_STARTUP=1
# EDGEQUAKE_STRICT_TENANT_BIND=1
# EDGEQUAKE_RATE_LIMIT_ENABLED=1
# EDGEQUAKE_OLLAMA_COMPAT_ENABLED=false
# EDGEQUAKE_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# EDGEQUAKE_REQUIRE_DELETE_ALL_CONFIRM=true
# REST-025: v1 async RPC returns 202 Accepted + Location when job id present (default: 200)
# REST-025: v1 async RPC returns HTTP 202 by default (Location + Link headers).
# Set EDGEQUAKE_V1_RPC_RETURN_202=0 for legacy HTTP 200 behavior.
# EDGEQUAKE_V1_RPC_RETURN_202=0

# Builtin OIDC (SPEC-027 phase 54) — opt-in; default off (use oauth2-proxy instead)
# EDGEQUAKE_OIDC_ENABLED=true
# EDGEQUAKE_OIDC_ISSUER_URL=https://your-idp.example.com
# EDGEQUAKE_OIDC_CLIENT_ID=edgequake
# EDGEQUAKE_OIDC_CLIENT_SECRET=your-client-secret
# EDGEQUAKE_OIDC_REDIRECT_URI=https://api.example.com/api/v1/auth/oidc/callback
# EDGEQUAKE_OIDC_SUCCESS_REDIRECT_URL=https://app.example.com/auth/callback

# =============================================================================
# Logging & Observability (SPEC-018)
# =============================================================================
# Logging Level — per-crate: trace, debug, info, warn, error
RUST_LOG=edgequake=info,edgequake_api=info,edgequake_query=warn,edgequake_pipeline=info,edgequake_storage=warn,tower_http=warn,sqlx=warn

# Structured JSON logs (recommended for production / log aggregators)
# EDGEQUAKE_LOG_FORMAT=json

# Log span close events (duration) on each completed span
# EDGEQUAKE_LOG_SPAN_EVENTS=1

# OTLP trace export (requires binary built with --features otel)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=edgequake-api
# EDGEQUAKE_OTEL_ENABLED=1
#
# Langfuse LLM observability (SPEC-124) — OTLP/HTTP; otel is on by default.
# Put these in THIS file (uncommented) — `make dev` sources repo-root `.env`.
# Prefer unquoted values. Quoted values (Langfuse UI copy-paste) are accepted:
# Rust + make strip one matching "..." / '...' pair so OTLP auth does not 401.
# Shell `export` alone is easy to lose across terminals; `.env` is the durable path.
#
# Cloud (default docs):
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
#
# Local Langfuse v4 Docker — preferred: make dev-langfuse / make dev-bg-langfuse
# (starts Compose + injects init keys; no .env edit required).
#   make langfuse-up   # UI only, if you already have a backend
# Headless keys (must match docker-compose.langfuse.yml):
# LANGFUSE_PUBLIC_KEY=pk-lf-edgequake-local
# LANGFUSE_SECRET_KEY=sk-lf-edgequake-local-dev
# LANGFUSE_BASE_URL=http://localhost:3310
# LANGFUSE_PROJECT_ID=edgequake-local
#
# Optional override. When unset, GET {LANGFUSE_BASE_URL}/api/public/projects
# (project-scoped keys) is fetched once per process and cached.
# LANGFUSE_PROJECT_ID=
# EDGEQUAKE_LANGFUSE_ENABLED=1
#
# Transport (SPEC-124). Default auto: probe OTLP, fall back to native ingestion
# only on HTTP 404 (Langfuse 3.1.x has no /api/public/otel). Force otlp for
# Cloud / ≥ 3.22. Force ingestion only when you know the host is pre-OTLP.
# How-to: docs/operations/langfuse-3.1.md
# Upgrade to Langfuse ≥ 3.22 remains recommended — ingestion is deprecated
# (Cloud sunsets trace events 2026-11-16; v4 events_only rejects it).
# EDGEQUAKE_LANGFUSE_API=auto
#
# SPEC-145: Optional Complete-class ceiling (bytes). Default 0 = unlimited (never
# product-truncate LLM Input/Output). Set a positive value only if you need a hard
# safety clamp (then io_complete=false is recorded). Secrets are still redacted.
# EDGEQUAKE_LANGFUSE_IO_MAX_BYTES=0
# EDGEQUAKE_LANGFUSE_IO_MAX_BYTES=1048576
#
# Langfuse 3.1.1 isolated stack + unfakable E2E (UI :3320):
#   make langfuse-3.1-up
#   make spec124-langfuse-3.1-e2e
# Langfuse 3.22.0 (first OTLP route) isolated stack (UI :3330):
#   make langfuse-3.22-up
#   make spec124-langfuse-3.22-e2e   # route+probe (3.22.0 parser cannot persist current OTEL proto)
# Langfuse 3.225.5 (current 3.x) OTLP persist (UI :3340):
#   make langfuse-3.225-up
#   make spec124-langfuse-3.225-e2e
# Current Langfuse Cloud (requires Cloud keys in this file):
#   make spec124-langfuse-cloud-e2e
#   make spec124-langfuse-matrix   # 3.1.1 + 3.22.0 + 3.225.5 + Cloud
#   make langfuse-sync-prices   # catalogue prices (LAW-124-12: we never emit cost)

# DB pool Prometheus gauge sampling interval (seconds, min 5; default 15)
# EDGEQUAKE_DB_POOL_METRICS_INTERVAL_SECS=15

# Docker: docker build --build-arg ENABLE_OTEL=true -f edgequake/docker/Dockerfile .

# =============================================================================
# Frontend Configuration
# =============================================================================
# Disable the demo login button in production deployments (closes GitHub issue #139).
# When set to "true" the "Continue without login (Demo)" button is hidden on the
# login page.  Leave unset or set to "false" for development / demo environments.
# NEXT_PUBLIC_DISABLE_DEMO_LOGIN=true

# WebUI backend readiness poll. Unset (default) = one /live+/health probe on
# page load. Set to 10000 to restore the previous 10s loop.
# EDGEQUAKE_HEALTH_POLL_MS=10000

# Placeholder Cloud keys — leave commented. Uncomment only with real Cloud keys.
# Dummy values here would make `make dev` try (and fail) Cloud export.
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxxxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxxxxxx
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
