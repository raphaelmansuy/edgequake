# EdgeQuake Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose your LLM provider: "openai", "ollama", or "mock"

# Option 1: OpenAI (Recommended for production)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Option 2: Ollama (Recommended for local development)
# Default configuration used by `make dev`
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434

# Embedding Provider (can be same or different from LLM provider)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# Option 3: LM Studio (Alternative local provider)
# LLM_PROVIDER=lmstudio
# LLM_MODEL=your-model-name
# LLM_BASE_URL=http://localhost:1234/v1

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL Database URL (optional - enables persistent storage)
# If not set, the application will use in-memory storage (data lost on restart)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edgequake

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8080

# =============================================================================
# Worker Configuration
# =============================================================================
# Number of background workers for document processing
WORKER_THREADS=4

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging Level
# Options: trace, debug, info, warn, error
RUST_LOG=edgequake=debug,tower_http=debug,axum=debug
